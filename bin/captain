#!/usr/bin/env node

const cli = require('@vbarbarosh/node-helpers/src/cli');
const fs = require('node:fs');
const net = require('node:net');
const os = require('node:os');
const path = require('node:path');
const {chromium} = require('playwright');
const {spawn} = require('node:child_process');

const agent_dir = path.join(__dirname, '..', 'data', 'agent');
const news_file = path.join(agent_dir, 'news_seen.txt');
const page_file = path.join(__dirname, '..', 'build', 'agent.html');
const port = Number(process.env.PORT) || 9333;
const shots_dir = path.join(agent_dir, 'shots');
// The window's debugging port is reached through this socket in the project folder, from the same machine
// or from inside a container such as ai-box that shares the folder; no port is opened to the network.
const socket_file = path.join(agent_dir, 'cdp.sock');
const window_file = path.join(agent_dir, 'window.json');
// News that needs a decision ends a wait at once.
const wait_titles = ['OPERATION COMPLETE', 'PILOT PROMOTED', 'SHUTTLE NOT PREPARED', 'CARGO', 'GUARDIAN BROKEN'];
const usage = `usage: bin/captain <command>

    start              open the agent's game window (HEADLESS=1 for no window);
                       with the agent inside ai-box, run start on your machine: the commands reach it from the box
    stop               close it
    screen             what is on the screen; buttons are numbered [n]
    press <n|label>    press button n, or the first button whose label contains the text
    key <code> [s]     press a key, e.g. KeyR (dock / jump), KeyJ (map), Space (pulse); hold it s seconds
    status             the ship, cargo, contracts and objective as JSON
    wait [s]           let the game run up to s seconds (default 60); it returns as soon as something needs you:
                       docked, a card to pick, a contract complete, low hull, nothing to fly to, death
    autopilot on|off   standing orders (on by default): fly stage after stage, dock, jump; in the arcade, dodge and fight
    dock               in the arcade: fly to the station and open the depot once no raider is close
    news               what the game announced since you last asked
    shot               save a screenshot and print its path

Instructions: docs/agent/README.md`;

cli(main);

async function main()
{
    const command = process.argv[2];
    const args = process.argv.slice(3);
    switch (command) {
    case 'start':
        await captain_start();
        break;
    case 'stop':
        captain_stop();
        break;
    case 'relay':
        captain_relay();
        break;
    case 'screen':
        await page_run(async function (page) {
            console.log(await screen_text(page));
        });
        break;
    case 'press':
        await page_run(v => captain_press(v, args.join(' ')));
        break;
    case 'key':
        await page_run(v => captain_key(v, args[0], Number(args[1]) || 0));
        break;
    case 'status':
        await page_run(async function (page) {
            console.log(JSON.stringify(await page.evaluate(() => window.captain.status()), null, 2));
        });
        break;
    case 'wait':
        await page_run(v => captain_wait(v, Number(args[0]) || 60));
        break;
    case 'dock':
        await page_run(async function (page) {
            const ordered = await page.evaluate(() => window.captain.dock());
            console.log(ordered ? 'Flying to the station; the depot opens once no raider is within 700 m. Use wait.' : 'Only in the arcade.');
        });
        break;
    case 'autopilot':
        await page_run(async function (page) {
            const on = await page.evaluate(v => window.captain.autopilot(v), args[0] !== 'off');
            console.log(`Autopilot ${on ? 'on' : 'off'}.`);
        });
        break;
    case 'news':
        await page_run(async function (page) {
            console.log(await news_text(page));
        });
        break;
    case 'shot':
        await page_run(captain_shot);
        break;
    default:
        console.log(usage);
    }
}

async function captain_start()
{
    if (await socket_alive()) {
        console.log('The game is already running.');
        return;
    }
    const display = process.env.DISPLAY || process.env.WAYLAND_DISPLAY || (process.platform !== 'linux');
    if (!display && (process.env.HEADLESS !== '1')) {
        throw new Error('No display here (inside ai-box?). Run bin/captain start on your machine, outside the box; the commands reach the window from inside it.');
    }
    if (!fs.existsSync(page_file)) {
        throw new Error('build/agent.html is missing: run bin/build first');
    }
    fs.mkdirSync(agent_dir, {recursive: true});
    const args = [
        `--remote-debugging-port=${port}`,
        `--user-data-dir=${path.join(agent_dir, 'profile')}`,
        '--no-first-run',
        '--no-default-browser-check',
        '--no-sandbox',
        '--autoplay-policy=no-user-gesture-required',
        '--window-size=1280,860',
    ];
    if (process.env.HEADLESS === '1') {
        args.push('--headless=new');
    }
    args.push(`file://${page_file}`);
    const chrome = spawn(chromium.executablePath(), args, {detached: true, stdio: 'ignore'});
    chrome.unref();
    const relay = spawn(process.execPath, [__filename, 'relay'], {detached: true, stdio: 'ignore'});
    relay.unref();
    fs.writeFileSync(window_file, JSON.stringify({host: os.hostname(), chrome_pid: chrome.pid, relay_pid: relay.pid}));
    fs.writeFileSync(news_file, '0');
    for (let i = 0; i < 60; ++i) {
        if (await socket_alive()) {
            break;
        }
        await sleep(250);
    }
    await page_run(async function (page) {
        await page.waitForFunction(() => window.captain, null, {timeout: 15000});
        console.log(await screen_text(page));
    });
}

// Only the machine that opened the window can close it; the pids mean nothing anywhere else.
function captain_stop()
{
    if (!fs.existsSync(window_file)) {
        console.log('No game window was started.');
        return;
    }
    const info = JSON.parse(fs.readFileSync(window_file, 'utf8'));
    if (info.host !== os.hostname()) {
        console.log(`The window runs on ${info.host}: run bin/captain stop there.`);
        return;
    }
    for (const pid of [info.chrome_pid, info.relay_pid]) {
        try {
            process.kill(pid);
        }
        catch {
            // already closed
        }
    }
    fs.rmSync(window_file);
    fs.rmSync(socket_file, {force: true});
    console.log('Closed.');
}

// Runs next to the window: forwards the socket in the project folder to the window's debugging port.
function captain_relay()
{
    fs.rmSync(socket_file, {force: true});
    const server = net.createServer(function (client) {
        const upstream = net.connect(port, '127.0.0.1');
        client.pipe(upstream).pipe(client);
        client.on('error', () => upstream.destroy());
        upstream.on('error', () => client.destroy());
    });
    server.listen(socket_file, function () {
        fs.chmodSync(socket_file, 0o600);
    });
    // The relay leaves with the window.
    async function relay_check() {
        if (!(await port_alive())) {
            server.close();
            fs.rmSync(socket_file, {force: true});
            process.exit(0);
        }
    }
    setInterval(relay_check, 5000);
}

async function captain_press(page, target)
{
    let button = null;
    if (/^\d+$/.test(target)) {
        button = page.locator(`[data-captain="${target}"]`);
        if (!(await button.count())) {
            throw new Error(`Button ${target} is gone: the screen changed. Run bin/captain screen again.`);
        }
    }
    else {
        await screen_text(page);
        button = page.locator('[data-captain]', {hasText: target}).first();
        if (!(await button.count())) {
            throw new Error(`No button with "${target}" on the screen. Run bin/captain screen.`);
        }
    }
    const pressed = await button.evaluate(function (v) {
        const holder = v.closest('.frontier-card, .shop-item');
        const title = holder ? (holder.querySelector('h3, b') || {textContent: ''}).textContent : '';
        return `${v.innerText}${title ? ` · ${title}` : ''}`.replace(/\s+/g, ' ').trim();
    });
    try {
        await button.click({timeout: 3000});
    }
    catch {
        throw new Error(`Could not press "${target}": something covers it. Run bin/captain screen.`);
    }
    console.log(`PRESSED ${pressed}`);
    await sleep(700);
    console.log(await screen_text(page));
}

async function captain_key(page, code, seconds)
{
    if (!code) {
        throw new Error('usage: bin/captain key <code> [seconds], e.g. key KeyR');
    }
    await page.keyboard.down(code);
    await sleep(Math.max(80, seconds*1000));
    await page.keyboard.up(code);
    await sleep(500);
    console.log(await screen_text(page));
}

async function captain_wait(page, seconds)
{
    const first = await page.evaluate(() => window.captain.status());
    const seen = fs.existsSync(news_file) ? Number(fs.readFileSync(news_file, 'utf8')) || 0 : 0;
    let reason = 'time is up';
    let idle = 0;
    let waited = 0;
    while (waited < seconds) {
        await sleep(1000);
        waited++;
        const status = await page.evaluate(() => window.captain.status());
        const news = await page.evaluate(v => window.captain.news(v), seen);
        const urgent = news.find(v => wait_titles.some(vv => v.title.includes(vv)));
        idle = ((status.state === 'playing') && !status.arcade && !status.objective) ? idle + 1 : 0;
        if (!['playing', 'transit'].includes(status.state) && (status.state !== first.state)) {
            reason = `the screen is now ${status.state}`;
        }
        else if (urgent) {
            reason = urgent.title;
        }
        else if ((hull_fraction(status) < 0.35) && (hull_fraction(first) >= 0.35)) {
            reason = `hull is low: ${status.hull}`;
        }
        else if (idle >= 3) {
            reason = 'nothing to fly to: choose a contract or a destination';
        }
        else {
            continue;
        }
        break;
    }
    console.log(`WAIT ENDED after ${waited}s: ${reason}`);
    console.log(await news_text(page));
    console.log(await screen_text(page));
    console.log(`STATUS ${JSON.stringify(await page.evaluate(() => window.captain.status()))}`);
}

function hull_fraction(status)
{
    if (!status.hull) {
        return 1;
    }
    const parts = status.hull.split(' / ');
    return Number(parts[0])/Number(parts[1]);
}

async function captain_shot(page)
{
    fs.mkdirSync(shots_dir, {recursive: true});
    const file = path.join(shots_dir, `${new Date().toISOString().replace(/[:.]/g, '-')}.png`);
    await page.screenshot({path: file});
    console.log(file);
}

// Connects to the window through the socket, runs fn with the agent's page, and disconnects.
async function page_run(fn)
{
    if (!fs.existsSync(socket_file)) {
        throw new Error('No game window is running. Start it with bin/captain start (on your machine, outside ai-box).');
    }
    const bridge = await bridge_open();
    try {
        const address = `127.0.0.1:${bridge.address().port}`;
        const response = await fetch(`http://${address}/json/version`);
        const version = await response.json();
        const endpoint = version.webSocketDebuggerUrl.replace(/^ws:\/\/[^/]+/, `ws://${address}`);
        const browser = await chromium.connectOverCDP(endpoint);
        try {
            const pages = browser.contexts().flatMap(v => v.pages());
            const page = pages.find(v => v.url().includes('agent.html'));
            if (!page) {
                throw new Error('The game window has no agent.html page; bin/captain stop, then start');
            }
            await page.evaluate(() => window.captain && window.captain.touch && window.captain.touch());
            await fn(page);
        }
        finally {
            await browser.close();
        }
    }
    finally {
        bridge.close();
    }
}

// A local port that leads into the socket, for the length of one command.
function bridge_open()
{
    return new Promise(function (resolve, reject) {
        const server = net.createServer(function (client) {
            const upstream = net.connect(socket_file);
            client.pipe(upstream).pipe(client);
            client.on('error', () => upstream.destroy());
            upstream.on('error', () => client.destroy());
        });
        server.on('error', reject);
        server.listen(0, '127.0.0.1', function () {
            resolve(server);
        });
    });
}

async function socket_alive()
{
    if (!fs.existsSync(socket_file)) {
        return false;
    }
    const bridge = await bridge_open();
    try {
        const response = await fetch(`http://127.0.0.1:${bridge.address().port}/json/version`, {signal: AbortSignal.timeout(1500)});
        return response.ok;
    }
    catch {
        return false;
    }
    finally {
        bridge.close();
    }
}

async function port_alive()
{
    try {
        const response = await fetch(`http://127.0.0.1:${port}/json/version`, {signal: AbortSignal.timeout(1500)});
        return response.ok;
    }
    catch {
        return false;
    }
}

// The open panel (or the flight HUD) as text; every enabled button carries its number [n] for press.
function screen_text(page)
{
    return page.evaluate(function () {
        for (const v of document.querySelectorAll('[data-captain]')) {
            v.removeAttribute('data-captain');
        }
        const overlay = Array.from(document.querySelectorAll('section.overlay')).find(v => !v.classList.contains('hidden'));
        const roots = overlay ? [overlay] : ['#mission', '.topbar .tools', '#loadout', '#toast.show'].map(v => document.querySelector(v)).filter(Boolean);
        const marks = [];
        let n = 0;
        for (const root of roots) {
            for (const button of root.querySelectorAll('button')) {
                if (!button.offsetParent) {
                    continue;
                }
                const mark = document.createElement('span');
                if (button.disabled) {
                    mark.textContent = '[-] ';
                }
                else {
                    n++;
                    button.dataset.captain = String(n);
                    mark.textContent = `[${n}] `;
                }
                button.prepend(mark);
                marks.push(mark);
            }
        }
        const text = roots.map(v => v.innerText).join('\n\n');
        for (const mark of marks) {
            mark.remove();
        }
        const title = overlay ? `SCREEN: ${overlay.id}` : 'SCREEN: flight';
        return `${title}\n${text.replace(/\n{3,}/g, '\n\n').trim().slice(0, 8000)}`;
    });
}

async function news_text(page)
{
    const seen = fs.existsSync(news_file) ? Number(fs.readFileSync(news_file, 'utf8')) || 0 : 0;
    const news = await page.evaluate(v => window.captain.news(v), seen);
    if (news.length) {
        fs.writeFileSync(news_file, String(news[news.length - 1].n));
    }
    const lines = news.map(v => `[${v.time}s] ${v.title}${v.sub ? ` · ${v.sub}` : ''}`);
    return lines.length ? `NEWS\n${lines.join('\n')}` : 'NEWS: nothing new';
}

function sleep(ms)
{
    return new Promise(function (resolve) {
        setTimeout(resolve, ms);
    });
}
