#!/usr/bin/env node

const child_process = require('node:child_process');
const cli = require('@vbarbarosh/node-helpers/src/cli');
const fs = require('node:fs');
const path = require('node:path');
const {chromium} = require('playwright');

const usage = `usage: bin/sound-render [--label=name] [--page=build/dev.html] [part...]

    Records the game's own sound as it plays in Chromium (build/dev.html, or --page: a build kept from before a change),
    taken after the compressor and the limiter, into data/sound/<label>/ (default: now) as WebM files, and measures each
    with ffmpeg: its peak and mean level (dB), and each effect's length. report.json holds the numbers.

    parts (all by default):
        effects   every effect of src/js/sfx/ alone, 2 s apart, at full volume, no music or hum: effects.webm;
                  effects.json gives the time of each
        themes    each world's calm theme in calm flight, 24 s, the engine's hum in it: theme-<world>.webm
        drive     each world's arcade music on its first wave, 32 s, effects off: drive-<world>.webm
        fight     an arcade wave in Ion Reach, 20 s, all of it: fight.webm, with a count of the effects played
        boss      Ion Reach's flagship fight, 20 s, all of it: boss.webm
        arrival   Ion Reach's arcade music, its flagship coming 600 m off 6 s in, 16 s, effects off: arrival.webm
        chain     six raiders' blasts and a ship's at once round you, 1 s in, no music: chain.webm`;
const parts = ['effects', 'themes', 'drive', 'fight', 'boss', 'arrival', 'chain'];
const worlds = ['haven', 'verdant', 'dustfall', 'ion-reach', 'obsidian', 'cryosphere', 'nova-forge', 'eclipse'];
// each effect starts this long after the one before (ms)
const effect_gap = 2000;
// seven blasts at once round you: six a raider's size and a ship's
const chain_code = 'for (let i = 0; i < 6; ++i) { explode(player.x + 220*Math.cos(i), player.y + 220*Math.sin(i), 40, "#ff8a3d"); } explode(player.x + 120, player.y, 72, "#ff8a3d");';
// the flagship's wave begun with it 600 m off, in the game's scope (a build from before arcade_wave_count too)
const arrival_code = 'arcade_wave_start((typeof arcade_wave_count === "function") ? arcade_wave_count() : arcade_waves); const b = enemies.find(v => v.type === "boss"); b.x = player.x + 600; b.y = player.y;';
// the page's own output, tapped where the game connects to the speakers, recorded by a MediaRecorder
const page_capture = `
(function () {
    const connect = AudioNode.prototype.connect;
    AudioNode.prototype.connect = function (target, ...rest) {
        const out = connect.call(this, target, ...rest);
        if (target instanceof AudioDestinationNode) {
            const c = target.context;
            c.__tap = c.__tap || c.createMediaStreamDestination();
            connect.call(this, c.__tap);
        }
        return out;
    };
    window.__record = function (c, ms, before) {
        return new Promise(function (resolve) {
            const rec = new MediaRecorder(c.__tap.stream, {mimeType: 'audio/webm;codecs=opus', audioBitsPerSecond: 128000});
            const chunks = [];
            rec.ondataavailable = e => chunks.push(e.data);
            rec.onstop = async function () {
                const bytes = new Uint8Array(await new Blob(chunks).arrayBuffer());
                let s = '';
                for (let i = 0; i < bytes.length; i += 32768) {
                    s += String.fromCharCode.apply(null, bytes.subarray(i, i + 32768));
                }
                resolve(btoa(s));
            };
            rec.start();
            before();
            setTimeout(() => rec.stop(), ms);
        });
    };
})();
`;

cli(main);

async function main()
{
    const args = process.argv.slice(2);
    const options = Object.fromEntries(args.filter(v => v.startsWith('--')).map(v => v.replace(/^--/, '').split('=')));
    const names = args.filter(v => !v.startsWith('--'));
    if (Object.keys(options).some(v => !['label', 'page'].includes(v)) || names.some(v => !parts.includes(v))) {
        console.log(usage);
        process.exit(2);
    }
    const chosen = names.length ? names : parts;
    const label = options.label || new Date().toISOString().slice(0, 19).replace(/[-:]/g, '').replace('T', '_');
    const out_dir = path.join(__dirname, '..', 'data', 'sound', label);
    fs.mkdirSync(out_dir, {recursive: true});
    // the game's scripts share one function's scope: a copy of the page with a door into it, as bin/perf makes
    const html = fs.readFileSync(options.page || path.join(__dirname, '..', 'build', 'dev.html'), 'utf8');
    const at = html.lastIndexOf('})();');
    const hooked = path.join(out_dir, 'dev-hooked.html');
    fs.writeFileSync(hooked, `${html.slice(0, at)}window.__t = function (code) { return eval(code); };\n${html.slice(at)}`);
    const browser = await chromium.launch({args: ['--autoplay-policy=no-user-gesture-required']});
    const report = {};
    try {
        for (const part of chosen) {
            await part_record(browser, hooked, out_dir, part, report);
        }
    }
    finally {
        await browser.close();
        fs.rmSync(hooked, {force: true});
    }
    fs.writeFileSync(path.join(out_dir, 'report.json'), JSON.stringify(report, null, 4));
    console.log(out_dir);
}

async function part_record(browser, hooked, out_dir, part, report)
{
    if (part === 'effects') {
        const page = await page_open(browser, hooked, 'world=0&screen=menu');
        const kinds = await page_eval(page, 'Object.keys(sfx_by_kind)');
        await page_eval(page, 'volume_settings.music = 0; volume_settings.ambience = 0; sound.music_trim.gain.value = 0; sound.ambient_bus.gain.value = 0;');
        const file = await page_record(page, out_dir, 'effects', 1000 + kinds.length*effect_gap + 1500, `Object.keys(sfx_by_kind).forEach((k, i) => setTimeout(() => sfx(k), 1000 + i*${effect_gap}));`);
        const effects = kinds.map((kind, i) => ({kind, at: 1 + i*effect_gap/1000, ...level_measure(file, 0.95 + i*effect_gap/1000, effect_gap/1000 - 0.05)}));
        fs.writeFileSync(path.join(out_dir, 'effects.json'), JSON.stringify(effects, null, 4));
        report.effects = effects;
        for (const v of effects) {
            console.log(`${v.kind.padEnd(14)} ${String(v.at).padStart(3)} s  peak ${v.peak} dB  mean ${v.mean} dB  ${v.length} s`);
        }
        await page.close();
        return;
    }
    if ((part === 'themes') || (part === 'drive')) {
        for (let i = 0; i < worlds.length; ++i) {
            const query = (part === 'themes') ? `world=${i}&screen=flight&god=1` : `world=${i}&screen=arcade&wave=1&god=1`;
            const page = await page_open(browser, hooked, query);
            if (part === 'drive') {
                await page_eval(page, 'volume_settings.effects = 0; sound.fx_bus.gain.value = 0;');
            }
            await page.waitForTimeout(2000);
            const name = `${(part === 'themes') ? 'theme' : 'drive'}-${worlds[i]}`;
            const file = await page_record(page, out_dir, name, (part === 'themes') ? 24000 : 32000);
            report[name] = {...level_measure(file), voices: await page_eval(page, 'sound.peak_voices')};
            console.log(`${name.padEnd(22)} peak ${report[name].peak} dB  mean ${report[name].mean} dB  voices at most ${report[name].voices}`);
            await page.close();
        }
        return;
    }
    if (part === 'chain') {
        const page = await page_open(browser, hooked, 'world=0&screen=flight&god=1');
        await page_eval(page, 'enemies = []; volume_settings.music = 0; volume_settings.ambience = 0; sound.music_trim.gain.value = 0; sound.ambient_bus.gain.value = 0;');
        const file = await page_record(page, out_dir, part, 5000, `setTimeout(() => window.__t(${JSON.stringify(chain_code)}), 1000);`);
        report[part] = level_measure(file);
        console.log(`${part.padEnd(22)} peak ${report[part].peak} dB  mean ${report[part].mean} dB`);
        await page.close();
        return;
    }
    if (part === 'arrival') {
        const page = await page_open(browser, hooked, 'world=3&screen=arcade&god=1');
        await page_eval(page, 'volume_settings.effects = 0; sound.fx_bus.gain.value = 0;');
        await page.waitForTimeout(2000);
        const file = await page_record(page, out_dir, part, 16000, `setTimeout(() => window.__t(${JSON.stringify(arrival_code)}), 6000);`);
        report[part] = level_measure(file);
        console.log(`${part.padEnd(22)} peak ${report[part].peak} dB  mean ${report[part].mean} dB`);
        await page.close();
        return;
    }
    const page = await page_open(browser, hooked, (part === 'fight') ? 'world=3&screen=arcade&wave=2&god=1' : 'world=3&screen=arcade&wave=flagship&god=1');
    await page_eval(page, 'window.__played = {}; const play = sfx; sfx = function (kind, ...rest) { window.__played[kind] = (window.__played[kind] || 0) + 1; return play(kind, ...rest); };');
    const file = await page_record(page, out_dir, part, 20000);
    report[part] = {
        ...level_measure(file),
        voices: await page_eval(page, 'sound.peak_voices'),
        played: await page_eval(page, 'window.__played'),
        boss: await page_eval(page, "(typeof music_drive_level === 'function') && (music_drive_level() === 2)"),
    };
    console.log(`${part.padEnd(22)} peak ${report[part].peak} dB  mean ${report[part].mean} dB  voices at most ${report[part].voices}  ${JSON.stringify(report[part].played)}`);
    await page.close();
}

async function page_open(browser, hooked, query)
{
    const page = await browser.newPage();
    page.on('pageerror', v => console.error(`${query}: ${v.message}`));
    await page.addInitScript(page_capture);
    await page.goto(`file://${hooked}?${query}`);
    await page.waitForTimeout(2500);
    await page_eval(page, 'muted = false; start_audio();');
    await page.waitForTimeout(500);
    return page;
}

function page_eval(page, code)
{
    return page.evaluate(v => window.__t(v), code);
}

// Records `ms` of the page's sound into <name>.webm, running `code` (in the game's scope) as it starts
async function page_record(page, out_dir, name, ms, code = '')
{
    const b64 = await page.evaluate(v => window.__record(window.__t('sound.ctx'), v.ms, () => window.__t(v.code)), {ms, code});
    const file = path.join(out_dir, `${name}.webm`);
    fs.writeFileSync(file, Buffer.from(b64, 'base64'));
    return file;
}

// The peak and mean level (dB) of a file, or of `length` s of it from `from`, and how long its sound lasts (s)
function level_measure(file, from = 0, length = 0)
{
    const window_args = length ? ['-ss', String(from), '-t', String(length)] : [];
    const r = child_process.spawnSync('ffmpeg', ['-hide_banner', ...window_args, '-i', file, '-af', 'volumedetect,silencedetect=n=-50dB:d=0.05', '-f', 'null', '-'], {encoding: 'utf8'});
    if (r.error) {
        return {peak: null, mean: null, length: null};
    }
    const peak = r.stderr.match(/max_volume: (-?[\d.]+)/);
    const mean = r.stderr.match(/mean_volume: (-?[\d.]+)/);
    const quiet = [...r.stderr.matchAll(/silence_start: ([\d.]+)/g)].map(v => Number(v[1])).find(v => v > 0.1);
    return {peak: peak ? Number(peak[1]) : null, mean: mean ? Number(mean[1]) : null, length: length ? (quiet ?? null) : null};
}
