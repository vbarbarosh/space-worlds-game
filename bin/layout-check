// The designer's twelve window sizes, from 1440p down to a half-width window and a short strip; then phones, two held
// upright and one on its side, for the screens marked phone (the crowded HUD, the race and the maps not yet)
const sizes = [
    [2560, 1440], [1920, 1080], [1600, 900], [1440, 900], [1366, 768], [1280, 720],
    [1024, 768], [943, 980], [800, 600], [640, 720], [1536, 348], [1280, 400],
];
const phone_sizes = [[320, 640], [390, 844], [844, 390]];
// Blocks that must not overlap each other; the panels and menus that must stay inside the window; controls that must
// not cut their own text; boxes whose text must not stick out
const selectors = {
    blocks: ['.dev-fps', '.hud-top .readouts', '.hud-top .toolbar', '.hud-top .brand', '.ui.hud .mission', '.ui.hud .minimap',
        '.hud-toasts > *', '.hud-toasts .toast', '.ui.hud .banners > *', '.ui.hud .race-board', '.hud-bottom .qbar', '.hud-bottom .shipstat', '.hud-bottom .hud-end', '.mm-left',
        '.depot-title', '.depot-stats', '.depot-wallet', '.depot-filters .seg', '.depot-search', '.depot-ship', '.depot-next',
        '.finale-title', '.finale-res', '.brk-title', '.brk-steps', '.brk-wallet', '.brk-won', '.brk-body', '.brk-foot'],
    contained: ['.modal', '.pause-layout', '.mm-left', '.has-panel .scene.on', '.depot-side', '.depot-top', '.depot-filters', '.finale-title h1', '.finale-res', '.brk-top', '.brk-foot', '.shipstat .cardfx'],
    clip: '.btn, .tab, .badge, .key, .qslot, .size, .alert, .seg button, .wallet, .meter-mini',
    boxes: '.card, .toast, .panel',
    // a mark in a corner of a screen (the menu's build stamp) stays inside the window and clear of what the screen shows
    marks: '.build-stamp',
    marked: '.mm-left > *, .mode, .fold-body, .has-panel .scene.on',
    // the buttons of the screen on top: whole in the window, not cut by a box round them, clear of each other
    buttons: 'button, .btn',
};
const usage = `usage: bin/layout-check [screen...]

    Opens every screen of build/dev.html at twelve window sizes, and the menu, the station, the flight HUD and
    the arcade's cleared screens at three phone sizes too (two upright, one on its side), and checks the
    interface holds together: HUD blocks do not overlap, panels stay in the window, every button of the screen
    on top is whole on screen and clear of the others, no control cuts its own text, no text sticks out of its
    box, the page never scrolls sideways. Screenshots and report.json go to data/layout-check/.
    Exits 1 on any failure.

    screens: ${[...new Set(screens.map(v => v.value))].join(', ')}`;

cli(main);

async function main()
{
    const names = process.argv.slice(2);
    if (names.some(v => !screens.some(vv => vv.value === v))) {
        console.log(usage);
        process.exit(2);
    }
    const chosen = names.length ? screens.filter(v => names.includes(v.value)) : screens;
    fs.mkdirSync(out_dir, {recursive: true});
    const browser = await chromium.launch();
    const results = [];
    try {
        for (const [w, h] of [...sizes, ...phone_sizes]) {
            const phone = phone_sizes.some(v => (v[0] === w) && (v[1] === h));
            const page = await browser.newPage({viewport: {width: w, height: h}});
            for (const screen of chosen.filter(v => !phone || v.phone)) {
                await page.goto(`file://${page_file}?world=${screen.world || 0}&screen=${screen.value}${screen.query || ''}`);
                // the screen is open once the dev panel has folded (its DEV tab shows); a page's first load can take
                // longer than the wait after it
                await page.waitForSelector('#dev_open:not(.hidden)', {state: 'attached', timeout: 15000});
                await page.waitForTimeout(1200);
                const shot = path.join(out_dir, screen.label, `${w}x${h}.png`);
                fs.mkdirSync(path.dirname(shot), {recursive: true});
                await page.screenshot({path: shot});
                const audit = await page.evaluate(layout_audit, selectors);
                const under = screen.ship ? await page.evaluate(ship_audit) : [];
                const failures = [
                    ...under.map(v => `ship under ${v}`),
                    ...audit.overlap.map(v => `overlap ${v}`),
                    ...audit.offscreen.map(v => `off ${v}`),
                    ...audit.cut.map(v => `cut ${v}`),
                    ...audit.clipped.map(v => `clip ${v}`),
                    ...audit.spill.map(v => `spill ${v}`),
                    ...(audit.hscroll ? ['hscroll'] : []),
                ];
                results.push({screen: screen.label, size: `${w}x${h}`, ok: !failures.length, failures, min_font: audit.min_font, shot});
                console.log(`${failures.length ? 'FAIL' : 'ok  '} ${screen.label.padEnd(18)} ${`${w}x${h}`.padEnd(10)} min ${audit.min_font}px${failures.length ? `  ${failures.join(' | ')}` : ''}`);
            }
            await page.close();
        }
    }
    finally {
        await browser.close();
    }
    fs.writeFileSync(path.join(out_dir, 'report.json'), JSON.stringify(results, null, 1));
    const failed = results.filter(v => !v.ok).length;
    console.log(`${results.length - failed} of ${results.length} pass · ${out_dir}`);
    if (failed) {
        process.exit(1);
    }
}

// Runs in the page: the HUD's blocks (and the window's edges) your ship's halo comes under; the news line and the
// banners come and go over the scene, and are left out
function ship_audit()
{
    const ship = window.dev_state().ship;
    const out = [];
    if (!ship) {
        return ['nothing: no ship'];
    }
    if ((ship.x < ship.r) || (ship.y < ship.r) || (ship.x > innerWidth - ship.r) || (ship.y > innerHeight - ship.r)) {
        out.push('the window edge');
    }
    for (const v of document.querySelectorAll('#hud_root [data-hud-safe]:not(#toasts):not(#banners), #touch_buttons > button')) {
        const r = v.getBoundingClientRect();
        if ((r.width < 1) || (r.height < 1)) {
            continue;
        }
        const dx = Math.max(r.left - ship.x, 0, ship.x - r.right);
        const dy = Math.max(r.top - ship.y, 0, ship.y - r.bottom);
        if (dx*dx + dy*dy < ship.r*ship.r) {
            out.push(v.id || v.className);
        }
    }
    return out;
}

// Runs in the page: what overlaps, leaves the window, is cut or sticks out, and the smallest text on screen
function layout_audit(selectors)
{
    const out = {overlap: [], offscreen: [], cut: [], clipped: [], spill: [], hscroll: false, min_font: 99};
    const view = {width: innerWidth, height: innerHeight};
    function visible(v) {
        const r = v.getBoundingClientRect();
        const s = getComputedStyle(v);
        return (r.width > 1) && (r.height > 1) && (s.visibility !== 'hidden') && (s.display !== 'none') && (Number(s.opacity) > 0.05) && !v.closest('[hidden]');
    }
    function name(v) {
        const classes = (typeof v.className === 'string') && v.className.trim() ? `.${v.className.trim().split(/\s+/).slice(0, 2).join('.')}` : v.tagName.toLowerCase();
        const text = v.textContent.trim().replace(/\s+/g, ' ').slice(0, 24);
        return text ? `${classes} "${text}"` : classes;
    }
    function outside(r) {
        return (r.left < -1) || (r.top < -1) || (r.right > view.width + 1) || (r.bottom > view.height + 1);
    }
    // At the point x, y, button v lies under an opaque box that is not its own: one whose background is solid and which
    // is neither inside v nor round it, nor the other button's (two buttons stacked are a collision)
    function covered(v, other, x, y) {
        for (const p of document.elementsFromPoint(x, y)) {
            if ((p === v) || v.contains(p)) {
                return false;
            }
            const alpha = getComputedStyle(p).backgroundColor.match(/[\d.]+/g)?.[3];
            if (!p.contains(v) && !other.contains(p) && ((alpha === undefined) ? (getComputedStyle(p).backgroundColor !== 'transparent') : (Number(alpha) >= 0.99))) {
                return true;
            }
        }
        return false;
    }
    // rect a holds rect b whole
    function holds(a, b) {
        return (b.left >= a.left - 1) && (b.top >= a.top - 1) && (b.right <= a.right + 1) && (b.bottom <= a.bottom + 1);
    }
    function corners(r) {
        return `[${Math.round(r.left)},${Math.round(r.top)} → ${Math.round(r.right)},${Math.round(r.bottom)}]`;
    }
    // inside a scrolling box, being out of the window is fine: you scroll to it
    function scrolled(v) {
        for (let p = v.parentElement; p; p = p.parentElement) {
            const s = getComputedStyle(p);
            if (/(auto|scroll)/.test(s.overflowY + s.overflowX) && ((p.scrollHeight > p.clientHeight + 1) || (p.scrollWidth > p.clientWidth + 1))) {
                return true;
            }
        }
        return false;
    }
    // the screen on top: the overlay shown last, or the HUD when none is
    const layers = Array.from(document.querySelectorAll('.overlay')).filter(visible);
    const layer = layers.length ? layers[layers.length - 1] : null;
    const blocks = [];
    for (const selector of selectors.blocks) {
        for (const v of document.querySelectorAll(selector)) {
            if (visible(v)) {
                blocks.push({selector, v, r: v.getBoundingClientRect()});
            }
        }
    }
    for (let i = 0, end = blocks.length; i < end; ++i) {
        for (let j = i + 1; j < end; ++j) {
            const a = blocks[i];
            const b = blocks[j];
            // a screen over the HUD (the depot) hides what is under it: only blocks of one layer can collide
            if ((a.v === b.v) || a.v.contains(b.v) || b.v.contains(a.v) || (a.v.closest('.overlay') !== b.v.closest('.overlay'))) {
                continue;
            }
            const ix = Math.min(a.r.right, b.r.right) - Math.max(a.r.left, b.r.left);
            const iy = Math.min(a.r.bottom, b.r.bottom) - Math.max(a.r.top, b.r.top);
            if ((ix > 2) && (iy > 2)) {
                out.overlap.push(`${a.selector} × ${b.selector} (${Math.round(ix)}×${Math.round(iy)}px)`);
            }
        }
    }
    for (const mark of document.querySelectorAll(selectors.marks)) {
        const r = mark.getBoundingClientRect();
        if (!visible(mark)) {
            continue;
        }
        if (outside(r)) {
            out.offscreen.push(`${selectors.marks} ${corners(r)}`);
        }
        for (const v of document.querySelectorAll(selectors.marked)) {
            const rv = v.getBoundingClientRect();
            const ix = Math.min(r.right, rv.right) - Math.max(r.left, rv.left);
            const iy = Math.min(r.bottom, rv.bottom) - Math.max(r.top, rv.top);
            if (visible(v) && (ix > 0) && (iy > 0)) {
                out.overlap.push(`${selectors.marks} × ${name(v)} (${Math.round(ix)}×${Math.round(iy)}px)`);
            }
        }
    }
    // a block under the screen on top (the HUD under the cleared screen) is not on the screen: only those of the top
    // layer must stay in the window
    for (const v of blocks) {
        if ((v.v.closest('.overlay') === layer) && outside(v.r)) {
            out.offscreen.push(`${v.selector} ${corners(v.r)}`);
        }
    }
    // The buttons of the screen on top: each whole in the window, or in a box that scrolls to it (the box is the
    // contained list's to keep in the window); not cut by a box round it, unless that box is folded shut (a menu row's button while the row is closed);
    // what shows of it clear of what shows of every other button (a list scrolled under a panel's foot is not over it)
    const buttons = [];
    for (const button of document.querySelectorAll(selectors.buttons)) {
        if (!visible(button) || button.closest('.dev-panel, .dev-open') || (button.closest('.overlay') !== layer) || buttons.some(v => v.v.contains(button))) {
            continue;
        }
        const r = button.getBoundingClientRect();
        // what of it shows: cut by every box round it that clips; whole, up to a box that scrolls to it
        let seen = {left: r.left, top: r.top, right: r.right, bottom: r.bottom};
        let whole = null;
        let scroller = null;
        let folded = false;
        for (let p = button.parentElement; p && (p !== document.body); p = p.parentElement) {
            const s = getComputedStyle(p);
            if ((s.overflowX === 'visible') && (s.overflowY === 'visible')) {
                continue;
            }
            const rp = p.getBoundingClientRect();
            if ((rp.width < 1) || (rp.height < 1)) {
                folded = true;
                break;
            }
            if (!scroller && /(auto|scroll)/.test(s.overflowY + s.overflowX) && ((p.scrollHeight > p.clientHeight + 1) || (p.scrollWidth > p.clientWidth + 1))) {
                scroller = p;
                whole = {...seen};
            }
            seen = {left: Math.max(seen.left, rp.left), top: Math.max(seen.top, rp.top), right: Math.min(seen.right, rp.right), bottom: Math.min(seen.bottom, rp.bottom)};
        }
        whole = whole || seen;
        if (folded) {
            continue;
        }
        if ((seen.right - seen.left > 2) && (seen.bottom - seen.top > 2)) {
            buttons.push({v: button, r: seen});
        }
        if (!scroller && outside(r)) {
            out.offscreen.push(`${name(button)} ${corners(r)}`);
        }
        else if ((whole.left > r.left + 1) || (whole.top > r.top + 1) || (whole.right < r.right - 1) || (whole.bottom < r.bottom - 1)) {
            out.cut.push(`${name(button)} ${corners(r)}`);
        }
    }
    for (let i = 0, end = buttons.length; i < end; ++i) {
        for (let j = i + 1; j < end; ++j) {
            const a = buttons[i].r;
            const b = buttons[j].r;
            const ix = Math.min(a.right, b.right) - Math.max(a.left, b.left);
            const iy = Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top);
            // one wholly on the other is a control set on it (the minimap's Hide on the minimap), not a collision; one
            // under an opaque box where they meet (a list scrolled under a solid panel foot) does not show there
            const x = Math.max(a.left, b.left) + ix/2;
            const y = Math.max(a.top, b.top) + iy/2;
            if ((ix > 2) && (iy > 2) && !holds(a, b) && !holds(b, a) && !covered(buttons[i].v, buttons[j].v, x, y) && !covered(buttons[j].v, buttons[i].v, x, y)) {
                out.overlap.push(`${name(buttons[i].v)} × ${name(buttons[j].v)} (${Math.round(ix)}×${Math.round(iy)}px)`);
            }
        }
    }
    for (const selector of selectors.contained) {
        for (const v of document.querySelectorAll(selector)) {
            const r = v.getBoundingClientRect();
            if (visible(v) && outside(r)) {
                out.offscreen.push(`${selector} ${corners(r)}`);
            }
        }
    }
    for (const v of document.querySelectorAll(selectors.clip)) {
        if (visible(v) && (v.scrollWidth > v.clientWidth + 1) && (getComputedStyle(v).overflowX !== 'auto')) {
            out.clipped.push(name(v));
        }
    }
    for (const box of document.querySelectorAll(selectors.boxes)) {
        if (!visible(box) || (getComputedStyle(box).overflow !== 'visible')) {
            continue;
        }
        const rb = box.getBoundingClientRect();
        for (const v of box.querySelectorAll('h2,h3,h4,p,b,span,button,dd,small')) {
            const r = v.getBoundingClientRect();
            if (visible(v) && !scrolled(v) && ((r.right > rb.right + 2) || (r.left < rb.left - 2))) {
                out.spill.push(`${name(v)} in ${name(box).slice(0, 30)}`);
                break;
            }
        }
    }
    out.hscroll = document.documentElement.scrollWidth > view.width + 1;
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    while (walker.nextNode()) {
        const v = walker.currentNode.parentElement;
        if (!walker.currentNode.textContent.trim() || !v || !visible(v) || v.closest('svg') || v.closest('.dev-panel, .dev-open')) {
            continue;
        }
        const r = v.getBoundingClientRect();
        if ((r.bottom < 0) || (r.top > view.height) || (r.right < 0) || (r.left > view.width)) {
            continue;
        }
        const s = getComputedStyle(v);
        out.min_font = Math.min(out.min_font, parseFloat(s.fontSize)*(parseFloat(s.zoom) || 1));
    }
    out.overlap = [...new Set(out.overlap)];
    out.clipped = [...new Set(out.clipped)].slice(0, 8);
    out.spill = [...new Set(out.spill)].slice(0, 8);
    return out;
}
