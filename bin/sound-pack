#!/usr/bin/env node

const child_process = require('node:child_process');
const cli = require('@vbarbarosh/node-helpers/src/cli');
const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');
const {chromium} = require('playwright');

const ROOT = path.join(__dirname, '..');
const WORLDS = ['haven', 'verdant', 'dustfall', 'ion-reach', 'obsidian', 'cryosphere', 'nova-forge', 'eclipse'];
const RATE = 48000;

cli(main);

async function main()
{
    const args = process.argv.slice(2);
    if ((args.length > 1) || (args.length && !/^--label=[a-z0-9][a-z0-9_-]*$/.test(args[0]))) {
        throw new Error('usage: bin/sound-pack [--label=name] (requires Chromium and ffmpeg)');
    }
    const label = args.length ? args[0].slice(8) : `pack-${Date.now()}`;
    const directory = path.join(ROOT, 'data', 'sound', label);
    if (fs.existsSync(directory)) {
        throw new Error(`Already exists: ${directory}; choose another label to preserve the previous pack.`);
    }
    const probe = child_process.spawnSync('ffmpeg', ['-version'], {encoding: 'utf8'});
    if (probe.error || probe.status) {
        throw new Error('ffmpeg is required to encode and verify the sound pack.');
    }
    const source = source_from_game();
    const browser = await chromium.launch();
    const assets = [];
    try {
        const page = await browser.newPage();
        await page.addScriptTag({content: source});
        const inventory = await page.evaluate(() => ({effects: Object.keys(sfx_by_kind), music: world_audio}));
        await page.close();
        const jobs = jobs_from_inventory(inventory);
        fs.mkdirSync(directory, {recursive: true});
        // Independent renders use three pages; a bounded batch keeps PCM transfers from exhausting memory.
        for (let i = 0; i < jobs.length; i += 3) {
            const results = await Promise.allSettled(jobs.slice(i, i + 3).map(render_job));
            for (const result of results) {
                if (result.status === 'rejected') {
                    throw result.reason;
                }
            }
        }
        async function render_job(job) {
            const page = await browser.newPage();
            try {
                await page.addScriptTag({content: source});
                const result = await page.evaluate(render_asset, job);
                const file = `${job.name}.wav`;
                const destination = path.join(directory, file);
                fs.mkdirSync(path.dirname(destination), {recursive: true});
                const bytes = Buffer.from(result.base64, 'base64');
                fs.writeFileSync(destination, bytes);
                const ogg = `${job.name}.ogg`;
                const mp3 = `${job.name}.mp3`;
                audio_encode(destination, path.join(directory, ogg));
                audio_encode(destination, path.join(directory, mp3));
                assets.push({name: job.name, category: job.category, world: job.world, file, ogg, mp3,
                    loop: job.loop, bpm: job.bpm, frames: result.frames, duration: result.frames/RATE,
                    peak_db: result.peak_db, rms_db: result.rms_db, seam: result.seam,
                    sha256: crypto.createHash('sha256').update(bytes).digest('hex')});
                console.log(`${assets.length}/${jobs.length} ${file}`);
            }
            finally {
                await page.close();
            }
        }
    }
    finally {
        await browser.close();
    }
    assets.sort((a, b) => a.name.localeCompare(b.name));
    const manifest = {sample_rate: RATE, channels: 2, bits: 16, seed: 20261021,
        renderer_sha256: crypto.createHash('sha256').update(fs.readFileSync(__filename)).digest('hex'),
        source_sha256: crypto.createHash('sha256').update(source).digest('hex'),
        aliases: {enemy_rail: 'effects/enemy_railgun'}, assets};
    fs.writeFileSync(path.join(directory, 'manifest.json'), `${JSON.stringify(manifest, null, 4)}\n`);
    fs.writeFileSync(path.join(directory, 'playlist.m3u'), `#EXTM3U\n${assets.map(v => v.mp3).join('\n')}\n`);
    fs.writeFileSync(path.join(directory, 'README.md'), render_readme(assets));
    console.log(`Validated ${assets.length} assets: ${directory}`);
}

// Only the declarations are loaded: no game loop, DOM controls or live audio timers run in the renderer.
function source_from_game()
{
    function read(file) {
        return fs.readFileSync(path.join(ROOT, 'src', 'js', file), 'utf8');
    }
    function prefix(text, boundary) {
        const at = text.indexOf(boundary);
        if (at < 0) {
            throw new Error(`Audio source boundary changed: ${boundary}`);
        }
        return text.slice(0, at);
    }
    const files = fs.readdirSync(path.join(ROOT, 'src', 'js', 'sfx')).filter(v => v.endsWith('.js')).sort();
    return [
        'let muted = false; const volume_settings = {master: 0.85, effects: 0.85, music: 0.65, ambience: 0.7};',
        'function clamp(n, a, b) { return Math.max(a, Math.min(b, n)); }',
        prefix(read('audio.js'), 'function sync_settings()'),
        ...WORLDS.map(v => read(`worlds/${v.replaceAll('-', '_')}.js`)),
        'const world_audio = [world_haven, world_verdant, world_dustfall, world_ion_reach, world_obsidian, world_cryosphere, world_nova_forge, world_eclipse].map(v => v.music);',
        ...files.map(v => read(`sfx/${v}`)),
        prefix(read('music.js'), 'function expedition_base_update_hud()'),
        read('music_drive.js'),
        explosion_schedule.toString(),
    ].join('\n');
}

function jobs_from_inventory(inventory)
{
    const out = [];
    for (const effect of inventory.effects) {
        out.push({name: `effects/${effect}`, category: 'effect', effect, loop: false});
        if (['blast', 'blast_big', 'blast_huge'].includes(effect)) {
            for (const variant of [2, 3]) {
                out.push({name: `effects/${effect}_${variant}`, category: 'effect', effect, variant, loop: false});
            }
        }
    }
    for (let i = 0, end = WORLDS.length; i < end; ++i) {
        const world = WORLDS[i];
        const music = inventory.music[i];
        for (const mode of ['calm', 'combat', 'drive', 'boss']) {
            const bpm = ['calm', 'combat'].includes(mode) ? music.bpm : music.drive.bpm*((mode === 'boss') ? 1.08 : 1);
            out.push({name: `music/${world}/${mode}`, category: 'music', world, id: i, mode, bpm, loop: true});
        }
        out.push({name: `music/${world}/boss-arrival`, category: 'stinger', world, id: i, loop: false});
        for (const layer of ['space', 'reactor']) {
            out.push({name: `flight/${world}/${layer}`, category: 'flight', world, id: i, layer, loop: true});
        }
    }
    for (const layer of ['engine', 'air']) {
        for (const mode of ['idle', 'thrust', 'turbo']) {
            // Idle air is turning at full deflection; straight idle flight is silent.
            out.push({name: `flight/${layer}-${mode}`, category: 'flight', layer, mode, loop: true});
        }
    }
    for (const demo of ['explosion-chain', 'weapons', 'ship-destruction', 'test-mix']) {
        out.push({name: `demos/${demo}`, category: 'demo', demo, loop: false});
    }
    return out;
}

async function render_asset(job)
{
    const rate = 48000;
    let seed = 20261021 + (job.variant || 0)*7919 + (job.id || 0)*101;
    Math.random = function () {
        seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
        return seed/4294967296;
    };
    const period = (job.category === 'music') ? Math.round(256*30/job.bpm*rate) : 12*rate;
    // Two preceding chords cover the longest pad and reverb, without rendering a discarded full cycle.
    const warmup = (job.category === 'music') ? Math.round(period/8) : 2*rate;
    const frames = job.loop ? period + warmup : 8*rate;
    const context = new OfflineAudioContext(2, frames, rate);
    create_audio_graph(context);
    // The original brown noise loses almost all its high end. Full-band noise lets the recipes' filters work.
    const noise_data = sound.noise.getChannelData(0);
    for (let i = 0, end = noise_data.length; i < end; ++i) {
        noise_data[i] = Math.random()*2 - 1;
    }
    sound.music_bus = context.createGain();
    sound.music_bus.gain.value = 0.8;
    sound.music_bus.connect(sound.music_trim);
    sound.music_bus.connect(sound.room);
    let rendered;
    function effect_play(kind, when) {
        if (['blast', 'blast_big', 'blast_huge'].includes(kind)) {
            explosion_schedule(kind, when);
        }
        else {
            sfx(kind, 1, null, when);
        }
    }
    if (job.category === 'effect') {
        effect_play(job.effect, 0);
    }
    else if (job.category === 'music') {
        const music = world_audio[job.id];
        const eighth = period/rate/256;
        function music_schedule(begin, finish) {
            for (let i = begin; i < finish; ++i) {
                const when = warmup/rate + i*eighth;
                const step = i + 256;
                if (['calm', 'combat'].includes(job.mode)) {
                    music_step(music, step, Math.max(0, when), job.mode === 'combat');
                }
                else {
                    music_drive_step(music, step, Math.max(0, when), eighth, (job.mode === 'boss') ? 2 : 1);
                }
            }
        }
        // Release ended voices between blocks; thousands of future nodes make Chromium's offline graph slow.
        music_schedule(-32, 0);
        const pauses = [];
        for (let i = 0; i < 256; i += 32) {
            pauses.push({step: i, promise: context.suspend(warmup/rate + i*eighth)});
        }
        const rendering = context.startRendering();
        for (const pause of pauses) {
            await pause.promise;
            music_schedule(pause.step, pause.step + 32);
            await context.resume();
        }
        rendered = await rendering;
    }
    else if (job.category === 'stinger') {
        music_drive_hit(world_audio[job.id], 0);
    }
    else if (job.category === 'flight') {
        const flight = sound.flight;
        const thrust = job.mode !== 'idle';
        const turbo = job.mode === 'turbo';
        if (job.layer === 'engine') {
            flight.engine.gain.value = 0.012 + (thrust ? 0.036 : 0) + (turbo ? 0.022 : 0);
            flight.filter.frequency.value = 700 + (thrust ? 250 : 0) + (turbo ? 450 : 0);
        }
        else if (job.layer === 'air') {
            flight.air_gain.gain.value = thrust ? 0.014 + (turbo ? 0.04 : 0) : 0.006;
            flight.air_filter.frequency.value = turbo ? 700 : 1200;
        }
        else if (job.layer === 'space') {
            flight.space_gain.gain.value = [0.014, 0.034, 0.025, 0.042, 0.035, 0.018, 0.05, 0.028][job.id];
            flight.space_filter.frequency.value = [420, 950, 380, 1500, 260, 1100, 650, 190][job.id];
        }
        else {
            flight.reactor_gain.gain.value = 0.008;
            flight.reactor.frequency.value = [62, 73, 55, 82, 46, 88, 65, 38][job.id];
        }
    }
    else if (job.demo === 'explosion-chain') {
        for (const when of [0, 0.09, 0.19, 0.32, 0.49, 0.7]) {
            effect_play('blast_big', when);
        }
        effect_play('blast_huge', 1.05);
    }
    else if (job.demo === 'ship-destruction') {
        effect_play('kill', 0);
        effect_play('blast_big', 0);
    }
    else if (job.demo === 'weapons') {
        for (let i = 0; i < 24; ++i) {
            effect_play('shot', i*0.09);
            effect_play('impact', i*0.09 + 0.045);
        }
    }
    else {
        for (const [i, note] of [48, 55, 62, 64].entries()) {
            tone(midi_frequency(note), 2.8, 'sine', 0.035, i*0.06, null, 1600, sound.music_trim, {attack: 0.25, release: 1.2, pan: (i % 2) ? 0.3 : -0.3});
        }
        effect_play('pickup', 0);
        tone(65, 0.8, 'sine', 0.065, 1.1, 90, 550);
        noise(0.5, 0.07, 800, 1.1);
    }
    rendered = rendered || await context.startRendering();
    const channels = [rendered.getChannelData(0), rendered.getChannelData(1)];
    const begin = job.loop ? warmup : 0;
    let finish = frames;
    if (!job.loop) {
        while ((finish > rate/20) && (Math.max(Math.abs(channels[0][finish - 1]), Math.abs(channels[1][finish - 1])) < 0.00002)) {
            finish--;
        }
        finish = Math.min(frames, finish + rate/20);
    }
    let peak = 0;
    for (const channel of channels) {
        for (let i = begin; i < finish; ++i) {
            if (!Number.isFinite(channel[i])) {
                throw new Error(`Non-finite audio: ${job.name}`);
            }
            peak = Math.max(peak, Math.abs(channel[i]));
        }
    }
    if (peak < 0.000001) {
        throw new Error(`Silent asset: ${job.name}`);
    }
    const peaks = {blast: -6, blast_big: -4.5, blast_huge: -3, hit: -9, pulse: -6, impact: -18, kill: -12};
    const target_db = (job.category === 'effect') ? (peaks[job.effect] ?? -12) : -6;
    // Flight stems share a gain so thrust, turbo and the world's relative ambience levels survive export.
    const gain = (job.category === 'flight') ? 4 : Math.pow(10, target_db/20)/peak;
    const length = finish - begin;
    const buffer = new ArrayBuffer(44 + length*4);
    const view = new DataView(buffer);
    function text_write(offset, text) {
        for (let i = 0, end = text.length; i < end; ++i) {
            view.setUint8(offset + i, text.charCodeAt(i));
        }
    }
    text_write(0, 'RIFF');
    view.setUint32(4, buffer.byteLength - 8, true);
    text_write(8, 'WAVEfmt ');
    view.setUint32(16, 16, true);
    view.setUint16(20, 1, true);
    view.setUint16(22, 2, true);
    view.setUint32(24, rate, true);
    view.setUint32(28, rate*4, true);
    view.setUint16(32, 4, true);
    view.setUint16(34, 16, true);
    text_write(36, 'data');
    view.setUint32(40, length*4, true);
    let sum = 0;
    let output_peak = 0;
    // A 5 ms edge ramp removes discontinuities in stochastic loops without changing their musical length.
    const ramp = job.loop ? 240 : 48;
    for (let i = 0; i < length; ++i) {
        const envelope = Math.min(1, i/ramp, (length - 1 - i)/ramp);
        for (let j = 0; j < 2; ++j) {
            const value = channels[j][begin + i]*gain*envelope;
            if (Math.abs(value) >= 1) {
                throw new Error(`Clipped audio: ${job.name}`);
            }
            sum += value*value;
            output_peak = Math.max(output_peak, Math.abs(value));
            view.setInt16(44 + (i*2 + j)*2, Math.round(value*32767), true);
        }
    }
    const bytes = new Uint8Array(buffer);
    const chunks = [];
    for (let i = 0; i < bytes.length; i += 32768) {
        chunks.push(String.fromCharCode(...bytes.subarray(i, i + 32768)));
    }
    return {base64: btoa(chunks.join('')), frames: length, peak_db: 20*Math.log10(output_peak), rms_db: 10*Math.log10(sum/(length*2)), seam: 0};
}

// Broad, non-resonant pressure and debris: no ringing sawtooth or bandpass in the blast's body.
function explosion_schedule(kind, when)
{
    const scale = {blast: 0.65, blast_big: 1, blast_huge: 1.65}[kind];
    const context = sound.ctx;
    const duration = 2.5*scale;
    const rate = context.sampleRate;
    const buffer = context.createBuffer(1, Math.ceil(duration*rate), rate);
    const data = buffer.getChannelData(0);
    for (let i = 0, end = data.length; i < end; ++i) {
        data[i] = Math.random()*2 - 1;
    }
    function layer_schedule(cutoff, highpass, volume, attack, decay, delay) {
        const source = context.createBufferSource();
        source.buffer = buffer;
        const low = context.createBiquadFilter();
        low.type = 'lowpass';
        low.frequency.value = cutoff;
        low.Q.value = 0.5;
        const high = context.createBiquadFilter();
        high.type = 'highpass';
        high.frequency.value = highpass;
        high.Q.value = 0.5;
        const gain = context.createGain();
        const time = when + delay;
        gain.gain.setValueAtTime(0, time);
        gain.gain.linearRampToValueAtTime(volume, time + attack);
        gain.gain.exponentialRampToValueAtTime(0.00001, time + decay);
        source.connect(low);
        low.connect(high);
        high.connect(gain);
        gain.connect(sound.fx_bus);
        source.start(time);
        source.stop(time + decay + 0.02);
    }
    const variation = 0.9 + Math.random()*0.2;
    layer_schedule(115*variation, 30, 4, 0.065*scale, 2.1*scale, 0);
    layer_schedule(700, 95, 0.7, 0.013, 1.2*scale, 0);
    layer_schedule(2200, 650, 0.18, 0.003, 0.16, 0);
    for (const delay of [0.12, 0.27, 0.46, 0.7]) {
        layer_schedule(850, 140, 0.11, 0.012, 0.26*scale, delay*scale);
    }
}

function audio_encode(wav, destination)
{
    const codec = destination.endsWith('.mp3') ? ['libmp3lame', '2'] : ['libvorbis', '5'];
    const result = child_process.spawnSync('ffmpeg', ['-v', 'error', '-i', wav, '-c:a', codec[0], '-q:a', codec[1], destination], {encoding: 'utf8'});
    if (result.error || result.status) {
        throw new Error(`Encoding failed: ${destination}\n${result.stderr || result.error}`);
    }
    const decoded = child_process.spawnSync('ffmpeg', ['-v', 'error', '-i', destination, '-f', 'null', '-'], {encoding: 'utf8'});
    if (decoded.error || decoded.status) {
        throw new Error(`Decode check failed: ${destination}\n${decoded.stderr || decoded.error}`);
    }
}

function render_readme(assets)
{
    const rows = assets.map(v => `| ${v.name} | [WAV](${v.file}) | [MP3](${v.mp3}) | [Ogg](${v.ogg}) | ${v.loop ? 'Loop' : 'One shot'} |`);
    return `# World Explorer sound pack

Generated locally by bin/sound-pack from the recipes and scores described in sound.md.
Stereo, 48 kHz, 16-bit PCM WAV masters, MP3 and Ogg Vorbis listening copies.
Open playlist.m3u in an audio player, or choose a file below. manifest.json holds lengths,
levels, loop flags, tempos, source hash and WAV checksums.

The 28 named effects retain their documented pitches and timing, with full-band filtered
noise replacing the game's dark noise source. The three explosions are new non-resonant
pressure/noise designs, with three seeded takes per size. No external recordings or audio
generation service were used; the six reference recordings were unavailable.

Each world's calm, campaign-combat, arcade-drive and boss music is its existing score,
rendered for the complete 256-eighth cycle (32 bars), with full-band percussion. These are
new renders, not newly composed themes. Two preceding chords supply the reverb tails.
Boss-arrival stingers are separate so looping the boss track does not repeat the entrance.
Loops retain the exact rounded musical frame count, with a 5 ms ramp at each edge.
Use WAV for sample-accurate loops; MP3 is provided for listening and sharing.

Flight stems include engine idle/thrust/turbo, air turning/thrust/turbo, and each world's
space and reactor. air-idle means turning without thrust: straight idle air is silent.
Flight stems share a fixed gain of four; other files are individually peak normalized.
Use manifest levels to balance them during integration. Station shelter is space at 0.35 gain;
menu/docked/ducked states are mixer gains, not additional compositions.

The explosion-chain demo preserves every onset and overlapping tail. The game itself has
not been changed: its current cooldowns would still suppress tightly spaced explosions.
The ship-destruction demo combines kill and blast_big; weapons demonstrates repeated shots
and impacts; test-mix renders the settings test chord, pickup and thump.

Docking, UI clicks, wave/clear/life/shield-break cues and the other events explicitly described
as silent are not invented here. enemy_rail is an alias of enemy_railgun.
Audio is generated outside the game build and does not load into the game automatically.

| Asset | Master | MP3 | Ogg | Playback |
|---|---|---|---|---|
${rows.join('\n')}
`;
}
