                const set = Storage.prototype.setItem;
                Storage.prototype.setItem = function (key, value) {
                    if ((key === 'pulse_drift_saves_v1') || (key === 'pulse_drift_kept_v1')) {
                        throw new DOMException('The quota has been exceeded.', 'QuotaExceededError');
                    }
                    return set.call(this, key, value);
                };
            });
            await t('toggle_pause(); saves_open(\'pause\'); save_to_slot(0)');
            const saved = await t(`({news: ${news}, note: document.getElementById('saves_note').textContent, row: document.querySelector('#save_slots .slot b').textContent})`);
