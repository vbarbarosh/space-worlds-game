    {
        name: 'save-pay-back',
        about: 'a save with drones, their tier, the builder, three structures and a line: paid back once, plays, saves',
        page: 'index',
        run: async function ({page, t}) {
            const out = [];
            await t(`(${page_old_save_make})(30)`);
            await page.reload({waitUntil: 'load'});
            await page.waitForTimeout(500);
            const loaded = await t(`(${page_old_save_loaded})()`);
            // two drones past the free two, both tiers, the builder, two outposts and a platform, a line; of the 16 ore
            // they were built with 10 fit the hold; sold: the other 6, a store's 7 and a line's 9 of ore, 8 of iron
            const expected = 2*45 + 220 + 520 + 150 + 120 + 120 + 160 + 350 + (6 + 7 + 9)*loaded.prices.ore + 8*loaded.prices.iron;
            if (!loaded.offered || (loaded.salvage - 1000 !== expected)) {
                out.push(`Continue ${loaded.offered ? 'offered' : 'not offered'}; paid back ${loaded.salvage - 1000}, owed ${expected}`);
            }
            if ((loaded.ore !== 40) || loaded.left.length || loaded.goal || loaded.guide) {
                out.push(`after the pay-back: ${loaded.ore} ore aboard (40 owed), fields left ${JSON.stringify(loaded.left)}, goal ${JSON.stringify(loaded.goal)}, marker ${JSON.stringify(loaded.guide)}`);
            }
            if (!/PAID BACK: 2 MINING DRONES, .*3 STRUCTURES, 1 TRANSPORT LINE .*30 UNITS .*PROSPECTOR GOAL DROPPED · ◆ \d+$/.test(loaded.paid_back || '')) {
                out.push(`the news of the pay-back: ${loaded.paid_back}`);
            }
            const played = await t(`(${page_old_save_play})()`);
            if ((played.state !== 'playing') || (played.told !== 1) || !played.valid || (played.salvage !== loaded.salvage) || (played.done.join() !== 'explorer')) {
                out.push(`continued: ${JSON.stringify(played)}`);
            }
            await page.reload({waitUntil: 'load'});
            await page.waitForTimeout(500);
            const again = await t(`(${page_old_save_loaded})()`);
            if (!again.offered || (again.salvage !== played.salvage) || again.paid_back || again.left.length) {
                out.push(`loaded again: Continue ${again.offered ? 'offered' : 'not offered'}, salvage ${again.salvage} after ${played.salvage}, told again ${JSON.stringify(again.paid_back)}, fields left ${JSON.stringify(again.left)}`);
            }
            return out;
        },
