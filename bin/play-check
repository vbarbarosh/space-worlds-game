#!/usr/bin/env node

const cli = require('@vbarbarosh/node-helpers/src/cli');
const fs = require('node:fs');
const path = require('node:path');
const {chromium} = require('playwright');

const build_dir = path.join(__dirname, '..', 'build');
const data_dir = path.join(__dirname, '..', 'data', 'play-check');
// A case opens a page (the game's or the dev page, a copy with a hook into the game's scope, as bin/playtest's), plays
// through the game's own functions and returns what is wrong, a line each; an empty list passes. `storage` is put into
// localStorage before the page's script runs; `refused` makes every use of localStorage throw, as a browser set to
// block site data does. A page error fails a case unless the case says it expects them (errors: true).
const cases = [
    {
        name: 'storage-refused',
        about: 'with site data blocked the page still starts and the menu answers',
        page: 'index',
        refused: true,
        run: async function ({page, t}) {
            const out = [];
            if (await t('typeof menu_start') !== 'function') {
                out.push('the page\'s script did not run to its end');
                return out;
            }
            await t('menu_start(\'arcade\')');
            await page.waitForTimeout(600);
            if (await t('state') !== 'playing') {
                out.push(`an arcade run did not start: state ${await t('state')}`);
            }
            return out;
        },
    },
    {
        name: 'campaign-best-apart',
        about: 'a campaign\'s end leaves the arcade\'s bests as they were, and keeps a best of its own',
        page: 'index',
        storage: {pulse_drift_best: '100', pulse_drift_best_scroll: '200'},
        run: async function ({page, t}) {
            const out = [];
            // twice: with Free picked on the menu's Arcade row, then with Scroll
            for (const kind of ['free', 'scroll']) {
                await t(`arcade_kind_pick('${kind}'); menu_start('campaign')`);
                await page.waitForTimeout(600);
                await t('score = 5000; finish(false)');
                await page.waitForTimeout(300);
                const kept = await page.evaluate(() => [localStorage.getItem('pulse_drift_best'), localStorage.getItem('pulse_drift_best_scroll'), localStorage.getItem('pulse_drift_best_campaign')]);
                if (kept.join(' ') !== '100 200 5000') {
                    out.push(`${kind} picked: the bests read Free ${kept[0]}, Scroll ${kept[1]}, campaign ${kept[2]}; expected 100, 200, 5000`);
                }
                const line = await page.evaluate(() => document.getElementById('result_best').textContent);
                if (!line.includes('5,000') && !line.includes('5 000')) {
                    out.push(`${kind} picked: the result's line does not show the campaign's best: ${line.slice(0, 60)}`);
                }
                await t('menu_open()');
                await page.waitForTimeout(300);
            }
            return out;
        },
    },
    {
        name: 'marker-through-gate',
        about: 'a marker set by hand does not follow the ship through a world gate, and a saved one is read as this world\'s',
        page: 'dev',
        query: 'world=verdant&screen=flight',
        run: async function ({page, t}) {
            const out = [];
            // Verdant has more local portals than Haven: a marker on its last one, then the gate to Haven
            await t('track_local_point({x: portals[portals.length - 1].x, y: portals[portals.length - 1].y, portal: portals.length - 1}, \'PORTAL\')');
            await t('start_jump({world: 0, color: \'#fff\', label: \'JUMP\'})');
            await page.waitForFunction(() => window.__t('(state === \'playing\') && !jump'), null, {timeout: 30000});
            await page.waitForTimeout(500);
            if (await t('campaign.world') !== 0) {
                out.push('the jump did not reach Haven');
            }
            if (await t('guide_manual') !== null) {
                out.push(`the marker came through the gate: ${await t('JSON.stringify(guide_manual)')}`);
            }
            // a save whose marker names a portal this world has not: read without it, no error
            await t('checkpoint.guide = {x: 100, y: 100, label: \'OLD\', portal: 99}; reset_run(true)');
            await page.waitForTimeout(500);
            if (await t('!!guide_manual && (guide_manual.portal !== undefined)')) {
                out.push('a saved marker kept a portal this world has not');
            }
            return out;
        },
    },
    {
        name: 'goal-bonus-once',
        about: 'a goal pays its bonus once, and a goal reached is not offered again',
        page: 'dev',
        query: 'world=0&screen=station-career',
        run: async function ({page, t}) {
            const out = [];
            // every world visited: the Explorer goal's steps are all done the moment it is followed
            await t('campaign.visited = [0, 1, 2, 3, 4, 5, 6, 7]; campaign.goal = null; campaign.goals_done = []; render_station()');
            const before = await t('salvage');
            const reward = await t('goal_kinds.explorer.reward');
            await t('goal_choose(\'explorer\')');
            const first = await t('salvage');
            if (first !== before + reward) {
                out.push(`the first Follow paid ${first - before}, the bonus is ${reward}`);
            }
            await t('goal_choose(\'explorer\'); goal_choose(\'explorer\')');
            const again = await t('salvage');
            if (again !== first) {
                out.push(`two more Follows paid ${again - first} more`);
            }
            const offered = await page.evaluate(function () {
                const row = [...document.querySelectorAll('.goal-row')].find(v => v.textContent.includes('Explorer'));
                return row ? !!row.querySelector('button') : null;
            });
            if (offered !== false) {
                out.push(`the reached goal's row ${(offered === null) ? 'is not on the GOALS tab' : 'still has its Follow button'}`);
            }
            return out;
        },
    },
    {
        name: 'press-let-go-over-hud',
        about: 'a mouse press on the sky let go over a HUD block, or lost with the window\'s focus, is let go',
        page: 'dev',
        query: 'world=0&screen=flight',
        run: async function ({page, t}) {
            const out = [];
            const hud = await page.evaluate(function () {
                const r = document.getElementById('bottom_hud').getBoundingClientRect();
                return {x: r.x + r.width/2, y: r.y + r.height/2};
            });
            await page.mouse.move(1000, 250);
            await page.mouse.down();
            await page.waitForTimeout(400);
            await page.mouse.move(hud.x, hud.y, {steps: 6});
            await page.mouse.up();
            await page.waitForTimeout(300);
            if (await t('mouse_drive.held')) {
                out.push('the press is still held after the button was let go over the ship panel');
            }
            await page.waitForTimeout(2500);
            const speed = await t('Math.hypot(player.vx, player.vy)');
            if (speed > 5) {
                out.push(`the ship still flies ${Math.round(speed)} m/s, 2.8 s after the button was let go`);
            }
            // held again, then the window loses the focus
            await page.mouse.move(1000, 250);
            await page.mouse.down();
            await page.waitForTimeout(300);
            await page.evaluate(() => window.dispatchEvent(new Event('blur')));
            if (await t('mouse_drive.held')) {
                out.push('the press is still held after the window lost the focus');
            }
            await page.mouse.up();
            return out;
        },
    },
    {
        name: 'page-put-away',
        about: 'after the browser\'s Back and Forward the play log has a session again, and an event without one throws nothing',
        page: 'dev',
        query: 'world=0&screen=arcade',
        run: async function ({page, t}) {
            const out = [];
            // the page put away and shown again, as the back and forward cache does it
            await page.evaluate(function () {
                window.dispatchEvent(new PageTransitionEvent('pagehide', {persisted: true}));
                window.dispatchEvent(new PageTransitionEvent('pageshow', {persisted: true}));
            });
            if (await t('play_log_session && play_log_session.mode') !== 'arcade') {
                out.push(`no arcade session after the page was shown again: ${await t('play_log_session && play_log_session.mode')}`);
            }
            if (await t('play_log_session && play_log_session.start.how') !== 'page shown again') {
                out.push('the new session does not say how it began');
            }
            // an event with no session at all: nothing written, nothing thrown
            await t('play_log_session_end(\'probe\'); play_log_event(\'card\', {card: \'probe\'})');
            return out;
        },
    },
    {
        name: 'stored-texts-as-text',
        about: 'markup in a save\'s texts (a contract, a marker, a rival\'s colour, a slot\'s numbers) stays text on every screen',
        page: 'dev',
        query: 'world=0&screen=station-jobs&contracts=full',
        run: async function ({page, t, open}) {
            const out = [];
            const markup = '<img src=x onerror="window.play_check_ran = 1">';
            // a place is clean when no img was made in it and nothing ran
            async function clean(where, selector) {
                await page.waitForTimeout(300);
                const made = await page.evaluate(v => document.querySelectorAll(`${v} img[src="x"]`).length, selector);
                if (made || await page.evaluate(() => window.play_check_ran)) {
                    out.push(`${where}: the markup came alive (${made} elements made)`);
                }
            }
            // docked: the taken contracts' cards and the NEXT strip
            await t(`campaign.contracts[0].title = ${JSON.stringify(markup)}; campaign.contracts[0].description = ${JSON.stringify(markup)}; campaign.tracked_id = campaign.contracts[0].id; guide_manual = {x: station.x + 400, y: station.y, label: ${JSON.stringify(markup)}}; render_station()`);
            await clean('the station', 'body');
            // in flight: the HUD's card
            await t('guide_manual = null; undock(); update_hud()');
            await page.waitForTimeout(800);
            await t('update_hud()');
            await clean('the flight HUD', 'body');
            // a race: a rival's colour from a stored course
            await open('dev', 'world=0&screen=race');
            await t(`race.racers.filter(v => v.rival)[0].color = ${JSON.stringify(`#fff"></i>${markup}<i x="`)}`);
            await page.waitForTimeout(700);
            await clean('the race\'s standings', 'body');
            if (!/^#[0-9a-f]{6}$/i.test(await t(`race_rival_make({name: 'A', hull: 'ship-scout', skill: 0.5, color: ${JSON.stringify(markup)}}, 1, 0, 1).color`))) {
                out.push('a rival made from a stored course keeps a colour that is not a colour');
            }
            // the depot: a slot's kills
            await open('dev', 'world=dustfall&screen=arcade-depot');
            await t(`kills = ${JSON.stringify(markup)}; arcade_depot_fill()`);
            await clean('the depot\'s header', 'body');
            return out;
        },
    },
    {
        name: 'race-keeps-off-saves',
        about: 'in a Races mode race F5 and F9 do nothing; a load from elsewhere leaves the Races mode, its campaign put back',
        page: 'index',
        run: async function ({page, t}) {
            const out = [];
            // a campaign saved to slot 1, then a race on the menu's Races row
            await t('menu_start(\'campaign\')');
            await page.waitForTimeout(600);
            await t('salvage = 4242; save_to_slot(0); menu_open(); race_mode_start(\'normal\', 0)');
            await page.waitForTimeout(800);
            for (const key of ['F9', 'F5']) {
                await page.keyboard.press(key);
                await page.waitForTimeout(400);
                const after = await t('({race: race_mode.active, course: !!race.course, state, saves: !document.getElementById(\'saves_overlay\').classList.contains(\'hidden\')})');
                if (!after.race || !after.course || after.saves || (after.state !== 'playing')) {
                    out.push(`${key} in a race: the Races mode ${after.race ? 'on' : 'off'}, its course ${after.course ? 'kept' : 'gone'}, the saves panel ${after.saves ? 'open' : 'shut'}, state ${after.state}`);
                }
            }
            // whatever loads a slot (a button the race hides, a tool) leaves the race: the campaign is the slot's, no
            // race HUD over it, and its saves work again
            // the salvage read in the same step as the load, before a frame of flight adds to it
            const salvage = await t('load_from_slot(0); salvage');
            await page.waitForTimeout(800);
            const loaded = {...await t('({race: race_mode.active, mode: document.body.classList.contains(\'race-mode\'), course: !!race.course})'), salvage};
            if (loaded.race || loaded.mode || loaded.course || (loaded.salvage !== 4242)) {
                out.push(`a load in a race: the Races mode ${loaded.race ? 'on' : 'off'}, its class ${loaded.mode ? 'kept' : 'gone'}, a course ${loaded.course ? 'left' : 'gone'}, salvage ${loaded.salvage} (the slot's 4242)`);
            }
            return out;
        },
    },
    {
        name: 'sound-sets',
        about: 'the sound set, the music set and a take picked in Settings: each kept across a load, nonsense read as new, a sound only the new set has silent in the classic',
        page: 'index',
        storage: {pulse_drift_sound_set: 'classic', pulse_drift_music_set: 'zzz'},
        run: async function ({page, t, open}) {
            const out = [];
            const read = '({sound: sound_set, music: music_set, gun: sfx_kind(\'gun_ion\'), shield: sfx_kind(\'shield_hit\'), rail: sfx_kind(\'enemy_rail\'), dock: sfx_kind(\'dock\')})';
            const first = await t(read);
            if ((first.sound !== 'classic') || (first.music !== 'new')) {
                out.push(`stored classic and nonsense: the sound set ${first.sound}, the music set ${first.music} (classic and new)`);
            }
            if ((first.gun !== 'enemy_ion') || (first.shield !== 'hit') || (first.rail !== 'enemy_railgun')) {
                out.push(`in the classic set your ion gun plays ${first.gun}, a hit on the shield ${first.shield}, a rail gun ${first.rail} (enemy_ion, hit, enemy_railgun)`);
            }
            // every sound asked for in a flight of each set, the new set's own among them: none throws, and one only
            // the new set has makes no voice in the classic one
            await t('start_audio(); muted = false; menu_start(\'arcade\')');
            await page.waitForTimeout(500);
            const voices = await t('(function () { sound.cues = {}; const before = sound.voices; for (const kind of Object.keys(sfx_new_by_kind).filter(v => !sfx_by_kind[v] && !sfx_new_by_kind[v].classic)) { sfx(kind); } return sound.voices - before; })()');
            if (voices !== 0) {
                out.push(`the classic set made ${voices} voices for sounds only the new set has`);
            }
            await t('settings_set(\'sound_set\', \'new\'); settings_set(\'music_set\', \'classic\')');
            const made = await t('(function () { sound.cues = {}; const before = sound.voices; for (const kind of Object.keys(sfx_new_by_kind)) { sfx(kind); } return sound.voices - before; })()');
            if (!(made > 0)) {
                out.push('the new set made no voice for its own sounds');
            }
            const second = await t(read);
            if ((second.sound !== 'new') || (second.music !== 'classic') || (second.gun !== 'gun_ion') || (second.shield !== 'shield_hit')) {
                out.push(`after Settings: the sound set ${second.sound}, the music set ${second.music}, your ion gun ${second.gun}, a hit on the shield ${second.shield}`);
            }
            // Settings' button for a family of takes does what its key does: the next take, said on the button, kept
            const take = await t('(function () { const button = document.querySelector(\'[data-take="blast"]\'); const before = sound_take(\'blast\'); button.click(); return {before, after: sound_take(\'blast\'), text: button.textContent, shown: !button.parentElement.classList.contains(\'hidden\')}; })()');
            if ((take.before === take.after) || !take.text.startsWith(`${take.after.toUpperCase()} of `) || !take.shown) {
                out.push(`Settings' Blast sound button: the take ${take.before} then ${take.after}, the button says "${take.text}", shown ${take.shown}`);
            }
            await open('index');
            const third = await t(`({...${read}, take: sound_take('blast')})`);
            if ((third.sound !== 'new') || (third.music !== 'classic')) {
                out.push(`after a load of the page: the sound set ${third.sound}, the music set ${third.music} (new and classic)`);
            }
            if (third.take !== take.after) {
                out.push(`after a load of the page: the blast's take ${third.take} (${take.after}, the one picked in Settings)`);
            }
            return out;
        },
    },
    {
        name: 'verdant-nests',
        about: 'Verdant\'s Free world: a nest burnt brings its wave\'s crest, the fifth the flagship; a load starts the five again',
        page: 'dev',
        query: 'world=verdant&screen=arcade',
        run: async function ({page, t}) {
            const out = [];
            if (await t('typeof brood_nests') !== 'object') {
                out.push('Verdant\'s Free world has no brood nests');
                return out;
            }
            // the nests as they stand, the wave, its crest and the card; your hull kept full, so no death cuts the case
            function now() {
                return t(`player.hp = hull_max(); ({
                    wave: arcade.wave,
                    crest: !!arcade.pace?.crest,
                    pause: arcade.pause > 0,
                    burnt: brood_nests_burnt(),
                    whole: brood_nests.filter(v => v.rock && (v.rock.hp === v.rock.max_hp) && (v.rock.max_hp > 1)).length,
                    rocks: ore_nodes.filter(v => (v.type === 'brood_nest') && (v.hp > 0)).length,
                    at: brood_nests.map(v => \`\${v.x},\${v.y}\`).join(' '),
                    flagship: enemies.some(v => (v.type === 'boss') && (v.hp > 0)),
                    card: document.getElementById('mc_title').textContent,
                })`);
            }
            // a nest burnt as a shot burns it (damage_ore), then the burst's front and its brood
            async function burn(i) {
                const brood = await t(`(function () {
                    const nest = brood_nests[${i}];
                    damage_ore(nest.rock, nest.rock.hp + 1);
                    return nest;
                })()`);
                await page.waitForTimeout(1000);
                return {...await now(), near: await t(`enemies.filter(v => (v.hp > 0) && (distance(v, ${JSON.stringify({x: brood.x, y: brood.y})}) < ${brood.r + 320})).length`)};
            }
            const start = await now();
            if ((start.wave !== 1) || (start.whole !== 5) || (start.rocks !== 5) || !start.card.startsWith('Burn the nests: 5')) {
                out.push(`the world's start: wave ${start.wave}, ${start.whole} of 5 nests whole, ${start.rocks} nest rocks on the map, card "${start.card}"`);
            }
            const first = await burn(2);
            if ((first.wave !== 1) || !first.crest || (first.burnt !== 1) || (first.rocks !== 4) || (first.near < 2) || !first.card.startsWith('Destroy its brood')) {
                out.push(`a nest burnt: wave ${first.wave}, crest ${first.crest ? 'come' : 'not come'}, ${first.burnt} burnt, ${first.rocks} nest rocks left, ${first.near} raiders round it, card "${first.card}"`);
            }
            // the next one burnt while the brood is out: its wave at once, and that wave's crest
            const second = await burn(0);
            if ((second.wave !== 2) || !second.crest || (second.burnt !== 2) || (second.near < 2)) {
                out.push(`a second nest burnt in the first's crest: wave ${second.wave}, crest ${second.crest ? 'come' : 'not come'}, ${second.burnt} burnt, ${second.near} raiders round it`);
            }
            // saved with two burnt, a third burnt, then the slot loaded: the world again from its first wave, its five
            // nests standing whole where they stood, none left over from before the load
            await t('save_to_slot(0)');
            await burn(4);
            await t('load_from_slot(0)');
            await page.waitForTimeout(800);
            const loaded = await now();
            if ((loaded.wave !== 1) || loaded.crest || (loaded.whole !== 5) || (loaded.rocks !== 5) || (loaded.at !== start.at) || !loaded.card.startsWith('Burn the nests: 5')) {
                out.push(`after a load: wave ${loaded.wave}, crest ${loaded.crest ? 'on' : 'off'}, ${loaded.whole} of 5 nests whole, ${loaded.rocks} nest rocks on the map, ${(loaded.at === start.at) ? 'in their places' : `at ${loaded.at}, not ${start.at}`}, card "${loaded.card}"`);
            }
            // the five in another order; the fifth's brood down, the breather says the flagship comes, then it does
            for (const i of [3, 1, 0, 4]) {
                await burn(i);
            }
            const fifth = await burn(2);
            if ((fifth.wave !== 5) || !fifth.crest || (fifth.burnt !== 5) || (fifth.rocks !== 0)) {
                out.push(`the fifth nest burnt: wave ${fifth.wave}, crest ${fifth.crest ? 'come' : 'not come'}, ${fifth.burnt} burnt, ${fifth.rocks} nest rocks left`);
            }
            for (let i = 0; (i < 10) && await t('enemies.some(v => v.hp > 0)'); ++i) {
                await t('for (const v of enemies) { if (v.hp > 0) { damage_enemy(v, 1e9); } }');
                await page.waitForTimeout(150);
            }
            await page.waitForTimeout(300);
            const rest = await now();
            if (!rest.pause || (rest.card !== 'Every nest burnt: the flagship is coming')) {
                out.push(`the fifth's brood down: ${rest.pause ? 'a breather' : 'no breather'}, card "${rest.card}"`);
            }
            await t('arcade.pause = Math.min(arcade.pause, 0.2)');
            await page.waitForTimeout(600);
            const last = await now();
            if ((last.wave !== 6) || !last.flagship) {
                out.push(`after the breather: wave ${last.wave}, ${last.flagship ? 'the flagship out' : 'no flagship'}`);
            }
            return out;
        },
    },
    {
        name: 'guns-mine',
        about: 'in the campaign your shots cut a rock: ore aboard, the mining stage counted, the rock\'s bar down',
        page: 'index',
        run: async function ({t}) {
            const out = [];
            const v = await t(`(${page_guns_mine})()`);
            if (v.idle.shots || (v.idle.reserve !== v.idle.reserve0)) {
                out.push(`with no mining stage and no pointer the guns took a rock: ${JSON.stringify(v.idle)}`);
            }
            if (!v.pointed.cut) {
                out.push(`the rock pointed at was not cut: ${JSON.stringify(v.pointed)}`);
            }
            if (!v.rested.cut) {
                out.push(`the rock was dropped while the pointer rested on it: ${JSON.stringify(v.rested)}`);
            }
            if (!v.marked.cut) {
                out.push(`with the map's marker on its field the rock was not cut: ${JSON.stringify(v.marked)}`);
            }
            if (!(v.stage.progress > 0) || (v.stage.loaded !== v.stage.progress)) {
                out.push(`a mining stage followed: cut ${v.stage.progress}, loaded ${v.stage.loaded}`);
            }
            if (!(v.stage.hp < v.stage.max_hp) || (Math.abs(v.stage.hp/v.stage.max_hp - v.stage.reserve/v.stage.reserve0) > 0.001)) {
                out.push(`the rock's bar does not show its reserve: ${JSON.stringify(v.stage)}`);
            }
            if (v.fight.cut || !v.fight.at_raider) {
                out.push(`with a raider 300 m off the guns stayed on the rock: ${JSON.stringify(v.fight)}`);
            }
            if (!v.pulse.cut) {
                out.push(`the pulse cut nothing from the rocks in its reach: ${JSON.stringify(v.pulse)}`);
            }
            return out;
        },
