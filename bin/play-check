                out.push(`Save here refused by the browser: the news ${JSON.stringify(saved.news)} (Not saved), the panel's note "${saved.note.slice(0, 50)}", the row "${saved.row}" (Empty)`);
            }
            await t('saves_close(); toggle_pause(); menu_open(); menu_start(\'campaign\')');
            const kept = await t(`({news: ${news}, kept: !!saves_kept_read()})`);
            if (!kept.news.includes('Earlier campaign not kept') || kept.kept) {
                out.push(`New campaign with the kept campaign refused: the news ${JSON.stringify(kept.news)} (Earlier campaign not kept), a kept campaign ${kept.kept}`);
            }
            return out;
        },
