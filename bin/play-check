    {
        name: 'haven-haulers',
        about: 'Haven\'s Free world: a hauler down opens its containers and brings its wave\'s crest, one let go leaves with its cargo, the fifth the flagship; a load starts the count again',
        page: 'dev',
        query: 'world=haven&screen=arcade',
        run: async function ({page, t}) {
            const out = [];
            if (await t('typeof hauler_run') !== 'object') {
                out.push('Haven\'s Free world has no haulers');
                return out;
            }
            // the hauler and its string, the world's count, the wave, its crest and the card; your hull kept full
            function now() {
                return t(`player.hp = hull_max(); ({
                    wave: arcade.wave,
                    crest: !!arcade.pace?.crest,
                    pause: arcade.pause > 0,
                    out: !!hauler_run.ship,
                    boxes: hauler_run.boxes.length,
                    parts: enemies.filter(v => v.hauler && (v.hp > 0)).length,
                    saved: hauler_run.saved,
                    taken: hauler_run.taken,
                    end: hauler_run.end,
                    way: \`\${hauler_run.side} to \${hauler_run.gate?.x},\${hauler_run.gate?.y}\`,
                    pickups: pickups.length,
                    flagship: enemies.some(v => (v.type === 'boss') && (v.hp > 0)),
                    card: document.getElementById('mc_title').textContent,
                })`);
            }
            // the hauler hurt as a shot hurts it, by a share of its whole hull (all that is left: more than 1)
            async function hurt(share) {
                await t(`damage_enemy(hauler_run.ship, (${share} > 1) ? hauler_run.ship.hp + 1 : hauler_run.ship.max_hp*${share})`);
                await page.waitForTimeout(1000);
                return now();
            }
            // the hauler put by its gate on its last leg, and the jump waited for
            async function let_go() {
                await t(`(function () {
                    const s = hauler_run;
                    s.leg = s.way.length - 1;
                    s.ship.event_goal = s.gate;
                    s.ship.x = s.gate.x;
                    s.ship.y = s.gate.y + ((s.gate.y > world.h/2) ? -1 : 1)*(s.gate.r + s.ship.r + 130);
                })()`);
                await page.waitForFunction(() => window.__t('!!hauler_run.end'), null, {timeout: 15000});
                await page.waitForTimeout(1000);
                return now();
            }
            // the wave's raiders down, the breather cut short, the next wave begun
            async function next_wave() {
                for (let i = 0; (i < 20) && await t('enemies.some(v => v.hp > 0)'); ++i) {
                    await t('for (const v of enemies) { if (v.hp > 0) { damage_enemy(v, 1e9); } }');
                    await page.waitForTimeout(150);
                }
                await page.waitForTimeout(300);
                const rest = await now();
                await t('arcade.pause = Math.min(arcade.pause, 0.2)');
                await page.waitForTimeout(700);
                return rest;
            }
            const start = await now();
            if ((start.wave !== 1) || !start.out || (start.boxes !== 3) || (start.parts !== 4) || !start.card.startsWith('Stop the hauler: cargo saved 0 of 15')) {
                out.push(`the world's start: wave ${start.wave}, ${start.out ? 'a hauler out' : 'no hauler'}, ${start.boxes} containers in tow, ${start.parts} of its 4 parts on the map, card "${start.card}"`);
            }
            const third = await hurt(0.34);
            if ((third.boxes !== 2) || (third.saved !== 1) || third.crest || (third.pickups < start.pickups + 3) || !third.card.startsWith('Stop the hauler: cargo saved 1 of 15')) {
                out.push(`a third of its hull gone: ${third.boxes} containers in tow, ${third.saved} saved, crest ${third.crest ? 'come' : 'not come'}, ${third.pickups - start.pickups} pickups more, card "${third.card}"`);
            }
            const down = await hurt(2);
            if ((down.wave !== 1) || !down.crest || down.out || (down.saved !== 3) || (down.taken !== 0) || (down.parts !== 0) || !down.card.startsWith('Destroy its escort')) {
                out.push(`a hauler down: wave ${down.wave}, crest ${down.crest ? 'come' : 'not come'}, ${down.saved} saved, ${down.taken} taken, ${down.parts} parts left on the map, card "${down.card}"`);
            }
            const rest = await next_wave();
            if (!rest.pause || (rest.card !== 'Cargo saved 3 of 15 · next hauler soon')) {
                out.push(`its escort down: ${rest.pause ? 'a breather' : 'no breather'}, card "${rest.card}"`);
            }
            // the second chased with its escort left behind: the ship kept at the hauler's beam, every raider of the
            // wave put 2 km off; within 5 s they are in reach again, ahead of the hauler
            const second = await now();
            const chase = `(function () {
                const ship = hauler_run.ship;
                player.x = ship.x + Math.sin(hauler_run.heading)*220;
                player.y = ship.y - Math.cos(hauler_run.heading)*220;
                player.vx = 0;
                player.vy = 0;
                player.hp = hull_max();
                return enemies.filter(v => (v.hp > 0) && !v.anchor && !v.event_kind && (distance(v, player) >= pace_reach)).length;
            })()`;
            for (let i = 0; (i < 40) && !await t('enemies.some(v => (v.hp > 0) && !v.anchor && !v.event_kind)'); ++i) {
                await t(chase);
                await page.waitForTimeout(200);
            }
            await t(chase);
            const left_behind = await t(`(function () {
                let out = 0;
                for (const v of enemies) {
                    if ((v.hp > 0) && !v.anchor && !v.event_kind) {
                        v.x = clamp(player.x + ((player.x > world.w/2) ? -2000 : 2000), 40, world.w - 40);
                        v.y = clamp(player.y + ((player.y > world.h/2) ? -2000 : 2000), 40, world.h - 40);
                        out++;
                    }
                }
                return out;
            })()`);
            let behind = left_behind;
            for (let i = 0; (i < 25) && (behind || (i < 3)); ++i) {
                await page.waitForTimeout(200);
                behind = await t(chase);
            }
            if (!left_behind || behind) {
                out.push(`an escort left behind a chase: ${left_behind} raiders put 2 km off, ${behind} still out of reach 5 s later`);
            }
            // then let go with all it tows: it leaves, the crest comes all the same, the count says so
            const gone = await let_go();
            if ((second.wave !== 2) || !second.out || (second.boxes !== 3) || (gone.wave !== 2) || (gone.end !== 'gone') || !gone.crest || (gone.saved !== 3) || (gone.taken !== 3) || (gone.parts !== 0) || !gone.card.startsWith('Destroy its escort')) {
                out.push(`a hauler let go: wave ${second.wave} began with ${second.boxes} containers in tow; then ${gone.end || 'still running'}, crest ${gone.crest ? 'come' : 'not come'}, ${gone.saved} saved, ${gone.taken} taken, ${gone.parts} parts left on the map, card "${gone.card}"`);
            }
            // saved in the second wave, the third hauler hurt, then the slot loaded: the world again from its first
            // wave, its first hauler whole on its way, the count from nothing, no part left over from before the load
            await t('save_to_slot(0)');
            await next_wave();
            await hurt(0.7);
            await t('load_from_slot(0)');
            await page.waitForTimeout(800);
            const loaded = await now();
            if ((loaded.wave !== 1) || loaded.crest || !loaded.out || (loaded.boxes !== 3) || (loaded.parts !== 4) || (loaded.saved !== 0) || (loaded.taken !== 0) || (loaded.way !== start.way) || !loaded.card.startsWith('Stop the hauler: cargo saved 0 of 15')) {
                out.push(`after a load: wave ${loaded.wave}, crest ${loaded.crest ? 'on' : 'off'}, ${loaded.boxes} containers in tow, ${loaded.parts} parts on the map, ${loaded.saved} saved, ${loaded.taken} taken, ${(loaded.way === start.way) ? 'on its way' : `${loaded.way}, not ${start.way}`}, card "${loaded.card}"`);
            }
            // the five: four down, the fourth let go with one container left; then the breather says the flagship
            // comes, and it does, with no hauler
            let fifth = null;
            for (let n = 1; n <= 5; ++n) {
                if (n === 4) {
                    await hurt(0.7);
                    await let_go();
                }
                else {
                    await hurt(2);
                }
                fifth = await next_wave();
            }
            if (!fifth.pause || (fifth.card !== 'Cargo saved 14 of 15 · now the flagship')) {
                out.push(`the fifth hauler's escort down: ${fifth.pause ? 'a breather' : 'no breather'}, card "${fifth.card}"`);
            }
            const last = await now();
            if ((last.wave !== 6) || !last.flagship || last.out || (last.parts !== 0) || (last.saved !== 14) || (last.taken !== 1)) {
                out.push(`after the breather: wave ${last.wave}, ${last.flagship ? 'the flagship out' : 'no flagship'}, ${last.out ? 'a hauler out' : 'no hauler'}, ${last.saved} saved, ${last.taken} taken`);
            }
            // the flagship down with its wave's raiders spent: the world's end pays the cargo in score and says it
            const before = await t('score');
            const pays = await t('arcade_task().cleared().points');
            await t('spawn_left = 0');
            await next_wave();
            await page.waitForFunction(() => window.__t('state === \'finale\''), null, {timeout: 20000}).catch(() => null);
            await page.waitForTimeout(300);
            const end = {state: await t('state'), line: await page.evaluate(() => document.getElementById('finale_line').textContent), paid: await t('score') - before};
            if ((end.state !== 'finale') || !end.line.includes('cargo saved 14 of 15') || (pays !== 2800) || (end.paid < pays)) {
                out.push(`the world's end: state ${end.state}, its line "${end.line.slice(0, 80)}", the cargo pays ${pays} (2800), the score rose ${end.paid}`);
            }
            return out;
        },
    },
];
// What a case's own failure says when the browser, not the game, lost the page's storage across a load
const storage_lost = 'the browser gave the page an empty storage after a load';
const usage = `usage: bin/play-check [case...]

    Plays the game's rules through its own functions, in build/index.html and build/dev.html (copies with a hook into
    the game's scope, in data/play-check/), and checks what bin/layout-check and bin/map-check do not look at: what a
    run keeps and what it must not, the save, the keys. A page error fails a case. A case in which the browser
    itself lost the page's storage across a load (seen on a loaded machine) is flown again, twice at most. Exits 1
    on any failure.

    cases:
${cases.map(v => `        ${v.name.padEnd(24)} ${v.about}`).join('\n')}`;

cli(main);

async function main()
{
    const names = process.argv.slice(2);
    if (names.some(v => !cases.some(vv => vv.name === v))) {
        console.log(usage);
        process.exit(2);
    }
    fs.mkdirSync(data_dir, {recursive: true});
    const hooked = {};
    for (const name of ['index', 'dev']) {
        const html = fs.readFileSync(path.join(build_dir, `${name}.html`), 'utf8');
        const at = html.lastIndexOf('})();');
        hooked[name] = path.join(data_dir, `${name}-hooked-${process.pid}.html`);
        fs.writeFileSync(hooked[name], `${html.slice(0, at)}window.__t = function (code) { return eval(code); };\n${html.slice(at)}`);
    }
    const browser = await chromium.launch({args: ['--mute-audio']});
    const failures = [];
    try {
        for (const v of cases.filter(vv => !names.length || names.includes(vv.name))) {
            let found = await case_run(browser, hooked, v);
            // on a loaded machine the browser at times hands the page an empty storage after a load (8 of 32 runs
            // with eight browsers at once): nothing can be judged from that, so the case is flown again
            for (let i = 0; (i < 2) && found.some(vv => vv.includes(storage_lost)); ++i) {
                found = await case_run(browser, hooked, v);
            }
            console.log(`${found.length ? 'FAIL' : 'ok  '} ${v.name.padEnd(24)} ${v.about}${found.length ? `\n     ${found.join('\n     ')}` : ''}`);
            failures.push(...found.map(vv => `${v.name}: ${vv}`));
        }
    }
    finally {
        await browser.close();
        for (const file of Object.values(hooked)) {
            fs.rmSync(file, {force: true});
        }
    }
    console.log(failures.length ? `${failures.length} failures` : 'all cases pass');
    if (failures.length) {
        process.exit(1);
    }
}

// In the page: how many keys localStorage holds; -1 where it is refused
function page_storage_count()
{
    try {
        return localStorage.length;
    }
    catch {
        return -1;
    }
}

async function case_run(browser, hooked, v)
{
    const context = await browser.newContext({viewport: {width: 1366, height: 768}});
    const out = [];
    try {
        const page = await context.newPage();
        const errors = [];
        page.on('pageerror', vv => errors.push(vv.message));
        if (v.refused) {
            await page.addInitScript(function () {
                Object.defineProperty(window, 'localStorage', {get: function () {
                    throw new DOMException('The operation is insecure.', 'SecurityError');
                }});
            });
        }
        if (v.storage) {
            // once a tab, by the window's name, which outlives a load of the page whatever the storage does: a mark in
            // sessionStorage went with the storage when the browser lost it (storage_lost), and the second seeding
            // then read as the game forgetting what it had stored
            await page.addInitScript(function (values) {
                if (window.name.includes('play_check_seeded')) {
                    return;
                }
                window.name = `${window.name} play_check_seeded`;
                for (const [key, value] of Object.entries(values)) {
                    localStorage.setItem(key, value);
                }
            }, v.storage);
        }
        await page.goto(`file://${hooked[v.page]}${v.query ? `?${v.query}` : ''}`, {waitUntil: 'load', timeout: 60000});
        await page.waitForTimeout(500);
        // the game's scope, when the page's script reached its end; null when it did not
        function t(code) {
            return page.evaluate(vv => (window.__t ? window.__t(vv) : null), code);
        }
        // another screen of the same case, or the same page loaded again; a storage that held something before the
        // load and nothing after it is the browser's loss, said as such
        async function open(name, query) {
            const kept = await page.evaluate(page_storage_count);
            await page.goto(`file://${hooked[name]}${query ? `?${query}` : ''}`, {waitUntil: 'load', timeout: 60000});
            await page.waitForTimeout(500);
            if ((kept > 0) && (await page.evaluate(page_storage_count) === 0)) {
                throw new Error(storage_lost);
            }
        }
        out.push(...await v.run({page, t, errors, open}));
        if (!v.errors && errors.length) {
            out.push(`${errors.length} page errors, the first: ${errors[0]}`);
        }
    }
    catch (error) {
        out.push(`the case itself failed: ${error.message.split('\n')[0]}`);
    }
    finally {
        await context.close();
    }
    return out;
}

// In the page (the game's scope, as the functions below): a new campaign out of the dock, the ship parked 60 m off the
// nearest rock the guide would lead to, as its FLY TO OBJECTIVE parks it, the story's first chapter at its scan. Then
// the same rock under the guns: nothing asked; pointed at; the pointer resting on it past its 2 s; the map's marker on
// its field; the chapter at its mining stage; a raider 300 m off; and the pulse over the field
function page_guns_mine()
{
    menu_start('campaign');
    accept_contract(story[campaign.story], true);
    undock();
    const m = campaign.contracts[0];
    const rock = mineable_deposits()[0];
    const spot = {x: rock.x - rock.r - 60, y: rock.y};
    let shots = 0;
    function fly(seconds, each = null) {
        for (let i = 0; i < seconds*60; ++i) {
            hostile = [];
            player.x = spot.x;
            player.y = spot.y;
            player.vx = player.vy = 0;
            player.hp = hull_max();
            if (each) {
                each();
            }
            const before = bullets.length;
            update(1/60);
            shots += Math.max(0, bullets.length - before);
        }
    }
    function point() {
        pointer.active = true;
        pointer.screen_x = (rock.x - camera.x)*zoom;
        pointer.screen_y = (rock.y - camera.y)*zoom;
    }
    function calm() {
        enemies = [];
    }
    function cut() {
        return (rock.reserve0 - rock.reserve)*ore_cut_cost + (rock.chip || 0);
    }
    update_camera(0, true);
    fly(4, calm);
    const idle = {shots, reserve: ore_reserve(rock), reserve0: rock.reserve0};
    let before = cut();
    fly(3, function () {
        calm();
        point();
        pointer.last = time;
    });
    const pointed = {cut: cut() - before};
    before = cut();
    fly(4, function () {
        calm();
        point();
    });
    const rested = {cut: cut() - before, since_moved: time - pointer.last};
    pointer.active = false;
    before = cut();
    track_local_point(mining_fields.find(v => v.id === rock.field), `MINING FIELD ${rock.field + 1}`);
    fly(3, calm);
    const marked = {cut: cut() - before};
    focus_contract(m);
    mission_event('scan', m.target);
    const aboard = cargo_count();
    fly(12, calm);
    const stage = {progress: m.progress, loaded: cargo_count() - aboard, hp: rock.hp, max_hp: rock.max_hp, reserve: rock.reserve, reserve0: rock.reserve0};
    calm();
    const raider = spawn_enemy('chaser');
    function hold() {
        raider.x = spot.x - 300;
        raider.y = spot.y;
        raider.hp = raider.max_hp;
    }
    // the bolts already on their way to the rock land first
    fly(1, hold);
    before = cut();
    fly(2, hold);
    const fight = {cut: cut() - before, at_raider: Math.abs(Math.cos(player.turret_angle) + 1) < 0.1};
    calm();
    const rocks = ore_nodes.filter(v => distance(v, player) < 400);
    const reserve = rocks.reduce((n, v) => n + ore_reserve(v)*ore_cut_cost - (v.chip || 0), 0);
    m.type = 'hunt';
    pulse_fire(player.x, player.y);
    fly(2, calm);
    const pulse = {rocks: rocks.length, cut: reserve - rocks.reduce((n, v) => n + ore_reserve(v)*ore_cut_cost - (v.chip || 0), 0)};
    return {idle, pointed, rested, marked, stage, fight, pulse};
}

// The story's first chapter taken, its scan done: from the scan's beacon the guide flies to the rocks (FLY TO
// OBJECTIVE) and the guns do the rest, no raiders about
function page_chapter_mining()
{
    menu_start('campaign');
    accept_contract(story[campaign.story], true);
    undock();
    const m = campaign.contracts[0];
    const beacon = beacons[m.stages[0].beacon];
    player.x = beacon.x;
    player.y = beacon.y;
    mission_event('scan', m.target);
    const title = m.stages[m.stage_index].title;
    guide_action();
    let seconds = 0;
    let shots = 0;
    while ((seconds < 180) && !m.ready && (state === 'playing')) {
        enemies = [];
        hostile = [];
        const before = bullets.length;
        update(1/60);
        shots += Math.max(0, bullets.length - before);
        refresh_guidance();
        seconds += 1/60;
    }
    return {ready: m.ready, title, seconds: Math.round(seconds), shots, progress: m.progress, target: m.target, state};
}

// A mining contract of 24 units and a hold filled to its last place with ore: the rock is cut on, then twelve units
// are sold and it is cut until the hold is full again
function page_hold_full()
{
    menu_start('campaign');
    accept_contract({...story[campaign.story], stages: [{type: 'mining', world: 0, target: 24, title: 'Mine'}]}, true);
    undock();
    const m = campaign.contracts[0];
    const rock = mineable_deposits()[0];
    let told = 0;
    const toast = show_toast;
    show_toast = function (title, ...rest) {
        told += (title === 'CARGO FULL') ? 1 : 0;
        toast(title, ...rest);
    };
    function fly(seconds) {
        const from = {reserve: ore_reserve(rock), aboard: cargo_count(), progress: m.progress, told};
        for (let i = 0; i < seconds*60; ++i) {
            enemies = [];
            hostile = [];
            player.x = rock.x - rock.r - 60;
            player.y = rock.y;
            player.vx = player.vy = 0;
            update(1/60);
        }
        return {cut: from.reserve - rock.reserve, loaded: cargo_count() - from.aboard, counted: m.progress - from.progress, told: told - from.told};
    }
    campaign.cargo.ore = cargo_capacity() - cargo_count();
    const full = fly(20);
    campaign.cargo.ore -= 12;
    const room = fly(5);
    campaign.cargo.ore += cargo_capacity() - cargo_count();
    const again = fly(8);
    show_toast = toast;
    return {full, room, again};
}

// An arcade run in Haven, no raiders let near: the nearest rock under the guns until it breaks, each hit counted, and
// a push wave over the rocks round the ship
function page_arcade_rocks()
{
    menu_start('arcade');
    arcade.pause = 1e9;
    const rock = ore_nodes.filter(v => (v.type === 'ore') && (v.hp > 0)).reduce((a, b) => ((distance(a, player) < distance(b, player)) ? a : b));
    const spot = {x: rock.x - rock.r - 120, y: rock.y};
    const max_hp = rock.max_hp;
    const salvage_before = pickups.filter(v => v.type === 'artifact').length;
    let hits = 0;
    let damage = 0;
    for (let i = 0; (i < 1200) && (rock.hp > 0); ++i) {
        enemies = [];
        hostile = [];
        player.x = spot.x;
        player.y = spot.y;
        player.vx = player.vy = 0;
        const hp = rock.hp;
        update(1/60);
        if (rock.hp < hp) {
            hits++;
            damage = Math.max(damage, hp - Math.max(0, rock.hp));
        }
    }
    const out = {broken: rock.hp <= 0, hits, hits_by_hull: Math.ceil(max_hp/damage), max_hp: Math.round(max_hp), damage, salvage_dropped: pickups.filter(v => v.type === 'artifact').length - salvage_before, cargo: cargo_count()};
    const near = ore_nodes.filter(v => (v.type === 'ore') && (v.hp > 0)).sort((a, b) => distance(a, player) - distance(b, player))[0];
    player.x = near.x - near.r - 100;
    player.y = near.y;
    push_ring_fire();
    for (let i = 0; i < 60; ++i) {
        enemies = [];
        hostile = [];
        update(1/60);
    }
    out.shoved = ore_nodes.filter(v => Math.hypot(v.vx, v.vy) > 0).length;
    return out;
}

// A campaign's autosave as the game wrote it while it had mining drones, a builder, structures and transport lines,
// put in place of the autosave: four drones (two bought), their top tier, the builder, an outpost with a store and a
// drone's load, an outpost half built and a defense platform in Haven, a line there with cargo aboard, `aboard` units
// in the scout's hold of 40, the Prospector goal followed with its marker on a field. With bare, a save that only
// follows the goal: the two free drones, nothing bought. With slot, kept in the first save slot, not as the autosave
function page_old_save_make(aboard, bare = false, slot = false)
{
    menu_start('campaign');
    undock();
    save_checkpoint();
    const v = JSON.parse(JSON.stringify(checkpoint));
    const c = v.campaign;
    const site = {world: 0, x: 4000, y: 4000, hp: 220, built: 1, store: 0, clock: 0, aim: 0, cooldown: 0};
    v.salvage = 1000;
    c.drones = bare ? 2 : 4;
    c.cargo.ore = Math.min(aboard, 36);
    c.cargo.iron = aboard - c.cargo.ore;
    c.goal = {id: 'prospector', step: 1};
    c.goals_done = ['explorer'];
    v.guide = {x: 4000, y: 4000, label: 'MINING FIELD · K BUILD AN OUTPOST'};
    if (!bare) {
        c.drone_tier = 2;
        c.builder = true;
        c.structures = [
            {...site, id: 1, kind: 'outpost', store: 12, loads: {ore: 7, iron: 5}, crew: [{x: 4000, y: 4000, angle: 0, state: 'cut', rock: null, load: {iron: 3}, count: 3}], idle: false},
            {...site, id: 2, kind: 'outpost', x: 5000, built: 0.4},
            {...site, id: 3, kind: 'platform', x: 8000, hp: 280},
        ];
        c.lines = {0: {hp: 900, cargo: {ore: 9}, count: 9, earned: 400}};
    }
    if (slot) {
        localStorage.removeItem('pulse_drift_frontier_v4');
        localStorage.setItem('pulse_drift_saves_v1', JSON.stringify([{saved_at: Date.now(), world: 'Haven', story: '0/16', ship: 'Wisp Scout', salvage: 1000, checkpoint: v}]));
        return;
    }
    localStorage.setItem('pulse_drift_frontier_v4', JSON.stringify(v));
}

// The autosave as the page read it at its start
function page_old_save_loaded()
{
    const c = checkpoint?.campaign;
    return {
        offered: !el.continue_row.classList.contains('hidden'),
        salvage: checkpoint?.salvage,
        paid_back: checkpoint?.paid_back || null,
        ore: c?.cargo.ore,
        aboard: c ? Object.values(c.cargo).reduce((a, b) => a + b, 0) : null,
        goal: c?.goal || null,
        guide: checkpoint?.guide || null,
        left: c ? ['drones', 'drone_tier', 'builder', 'structures', 'lines'].filter(v => v in c) : null,
        prices: {ore: commodity_base_price(0, 0) - 2, iron: commodity_base_price(0, commodities.findIndex(v => v.key === 'iron')) - 2},
    };
}

// The first save slot as its row shows it, then loaded and flown five seconds
function page_old_slot_load()
{
    let told = 0;
    const toast = show_toast;
    show_toast = function (title, ...rest) {
        told += (title === 'MINING DRONES AND OUTPOSTS ARE GONE') ? 1 : 0;
        toast(title, ...rest);
    };
    const row = saves_read()[0].salvage;
    load_from_slot(0);
    for (let i = 0; i < 300; ++i) {
        enemies = [];
        hostile = [];
        update(1/60);
    }
    update_hud();
    render();
    show_toast = toast;
    return {row, salvage, state, told, prices: {ore: commodity_base_price(0, 0) - 2, iron: commodity_base_price(0, commodities.findIndex(v => v.key === 'iron')) - 2}};
}

// Continue, ten seconds of flight with the HUD and the screen drawn, a dock with the goals tab open, and the autosave
// the game then made
function page_old_save_play()
{
    let told = 0;
    const toast = show_toast;
    show_toast = function (title, ...rest) {
        told += (title === 'MINING DRONES AND OUTPOSTS ARE GONE') ? 1 : 0;
        toast(title, ...rest);
    };
    menu_start('continue');
    for (let i = 0; i < 600; ++i) {
        enemies = [];
        hostile = [];
        update(1/60);
        if (i % 30 === 0) {
            update_hud();
            render();
        }
    }
    const flown = state;
    player.x = station.x;
    player.y = station.y + station_size/2 + 100;
    dock_station();
    station_tab = 'career';
    render_station();
    const goals_tab = document.getElementById('station_content').textContent.length > 0;
    undock();
    show_toast = toast;
    const saved = JSON.parse(localStorage.getItem('pulse_drift_frontier_v4'));
    return {state: flown, told, valid: valid_checkpoint(saved), salvage: saved.salvage, done: campaign.goals_done || [], goals_tab};
}
