            if (!row || (loaded.salvage !== 5000) || !['playing', 'upgrade'].includes(loaded.state) || loaded.kept) {
                out.push(`the saves panel's row "${String(row).slice(0, 60)}", after its Load: salvage ${loaded.salvage} (5000), state ${loaded.state}, a kept campaign ${loaded.kept} (none)`);
            }
            // Restart campaign at a pause, the game now further on: kept as it is now, and there after a load of the page
            await t('if (state === \'upgrade\') { undock(); } run_time = 400; salvage = 6000; toggle_pause()');
            await page.evaluate(() => document.getElementById('restart_pause').click());
            const third = await t(kept);
            if (!third || (third.salvage !== 6000)) {
                out.push(`after Restart campaign: the kept campaign ${JSON.stringify(third)} (salvage 6000)`);
            }
            // a slot loaded over a game further on (F9): the game before the load is the kept one
            await t('if (state === \'upgrade\') { undock(); } run_time = 500; salvage = 7000; save_to_slot(0); run_time = 600; salvage = 8000');
            await page.keyboard.press('F9');
            const loaded_slot = await t('salvage');
            const fourth = await t(kept);
            if ((loaded_slot !== 7000) || !fourth || (fourth.salvage !== 8000)) {
                out.push(`after F9 over a game further on: salvage ${loaded_slot} (the slot's 7000), the kept campaign ${JSON.stringify(fourth)} (salvage 8000)`);
            }
            await open('index');
            const fifth = await t(kept);
            if (!fifth || (fifth.salvage !== 8000)) {
