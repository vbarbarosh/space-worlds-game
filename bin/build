#!/usr/bin/env node

const cli = require('@vbarbarosh/node-helpers/src/cli');
const fs = require('node:fs');
const path = require('node:path');

const build_dir = path.join(__dirname, '..', 'build');
const include_regex = /^<!-- include (.+) -->\n$/;
const slot_regex = /^<!-- slot (.+) -->\n$/;
const svgs_regex = /^<!-- svgs (.+) as (.+) -->\n$/;
const missions_regex = /^<!-- missions (.+) as (.+) -->\n$/;
// What each stage kind's amount counts, and the worlds by name (src/missions/README.md)
const mission_kinds = ['scan', 'mining', 'courier', 'hunt', 'defend', 'recover', 'elite', 'boss', 'escort', 'trade', 'lure'];
const src_dir = path.join(__dirname, '..', 'src');
const variants = ['dev', 'agent'];

cli(main);

function main()
{
    fs.mkdirSync(build_dir, {recursive: true});
    build_index_html();
    for (const variant of variants) {
        build_variant_html(variant);
    }
}

function build_index_html()
{
    const template = fs.readFileSync(path.join(src_dir, 'index.html'), 'utf8');
    fs.writeFileSync(path.join(build_dir, 'index.html'), html_from_template(template, {}));
}

// The game page with src/<variant>.html's parts put into its slots
function build_variant_html(variant)
{
    const template = fs.readFileSync(path.join(src_dir, 'index.html'), 'utf8');
    const parts = fs.readFileSync(path.join(src_dir, `${variant}.html`), 'utf8');
    fs.writeFileSync(path.join(build_dir, `${variant}.html`), html_from_template(template, lines_by_slot_from_text(parts)));
}

// A line `<!-- slot js -->` takes the lines of that slot, or goes away; then
// a line `<!-- include css/base.css -->` is replaced by that file of src/, as it is
function html_from_template(template, lines_by_slot)
{
    const lines = [];
    for (const line of template.split(/(?<=\n)/)) {
        const match = line.match(slot_regex);
        if (match) {
            lines.push(...(lines_by_slot[match[1]] || []));
        }
        else {
            lines.push(line);
        }
    }
    const parts = [];
    for (const line of lines) {
        const match = line.match(include_regex);
        const svgs = line.match(svgs_regex);
        const missions = line.match(missions_regex);
        if (match) {
            parts.push(fs.readFileSync(path.join(src_dir, match[1]), 'utf8'));
        }
        else if (svgs) {
            parts.push(svgs_js(svgs[1], svgs[2]));
        }
        else if (missions) {
            parts.push(`const ${missions[2]} = ${JSON.stringify(missions_from_dir(path.join(src_dir, missions[1])))};\n`);
        }
        else {
            parts.push(line);
        }
    }
    return parts.join('');
}

// A `<!-- svgs sprites as sprite_svgs -->` line becomes `const sprite_svgs = {...};`: every .svg of src/sprites/ by
// its name without the extension, and every folder in it as an object of its own
function svgs_js(dir, name)
{
    return `const ${name} = ${JSON.stringify(svgs_from_dir(path.join(src_dir, dir)))};\n`;
}

function svgs_from_dir(dir)
{
    const out = {};
    for (const entry of fs.readdirSync(dir, {withFileTypes: true}).sort((a, b) => a.name.localeCompare(b.name))) {
        if (entry.isDirectory()) {
            out[entry.name] = svgs_from_dir(path.join(dir, entry.name));
        }
        else if (entry.name.endsWith('.svg')) {
            out[entry.name.slice(0, -4)] = fs.readFileSync(path.join(dir, entry.name), 'utf8').trim();
        }
    }
    return out;
}

// src/dev.html, src/agent.html: a `<!-- slot name -->` line opens a slot; the lines after it fill it
function lines_by_slot_from_text(text)
{
    const out = {};
    let slot = null;
    for (const line of text.split(/(?<=\n)/)) {
        const match = line.match(slot_regex);
        if (match) {
            slot = match[1];
            out[slot] = [];
        }
        else if (slot) {
            out[slot].push(line);
        }
    }
    return out;
}

// Every mission file of the folder: a story chapter (nn-name.md, number as its place) or a side mission (side-name.md,
// offered as a contract in its world); title, world, reward, description, story, stages
function missions_from_dir(dir)
{
    const worlds = world_names();
    const out = [];
    for (const name of fs.readdirSync(dir).filter(v => /^(\d+|side)-.+\.md$/.test(v)).sort()) {
        out.push(mission_from_text(name, fs.readFileSync(path.join(dir, name), 'utf8'), worlds));
    }
    return out;
}

// One mission file read, or an error naming its file and line
function mission_from_text(file, text, worlds)
{
    const lines = text.split('\n');
    function fail(i, message) {
        throw new Error(`src/missions/${file}:${i + 1}: ${message}`);
    }
    function world_of(i, name) {
        const id = worlds.indexOf(name.trim());
        if (id < 0) {
            fail(i, `unknown world "${name.trim()}"; one of ${worlds.join(', ')}`);
        }
        return id;
    }
    const out = {number: /^\d/.test(file) ? Number(file.match(/^\d+/)[0]) : null, file, title: '', world: -1, reward: 0, description: '', story: [], stages: []};
    let paragraph = [];
    for (let i = 0, end = lines.length; i < end; ++i) {
        const line = lines[i].trim();
        if (line.startsWith('# ')) {
            out.title = line.slice(2).trim();
        }
        else if (/^World:/.test(line)) {
            const m = line.match(/^World:\s*(.+?)\s*·\s*Reward:\s*(\d+)\s*$/);
            if (!m) {
                fail(i, 'expected "World: <name> · Reward: <salvage>"');
            }
            out.world = world_of(i, m[1]);
            out.reward = Number(m[2]);
        }
        else if (line.startsWith('|')) {
            const cells = line.split('|').slice(1, -1).map(v => v.trim());
            if ((cells[0] === 'Stage') || /^-+$/.test(cells[0])) {
                continue;
            }
            if (cells.length !== 5) {
                fail(i, 'a stage row has five cells: Stage | Kind | World | Amount | Where');
            }
            const [title, kind, world, amount, where] = cells;
            if (!mission_kinds.includes(kind)) {
                fail(i, `unknown kind "${kind}"; one of ${mission_kinds.join(', ')}`);
            }
            if (!/^\d+$/.test(amount)) {
                fail(i, `the amount "${amount}" is not a whole number`);
            }
            const stage = {title, type: kind, world: world_of(i, world), target: Number(amount)};
            const beacon = where.match(/^beacon\s+([1-3])$/);
            const commodity = where.match(/^commodity\s+(ore|cells|relics)$/);
            if (beacon) {
                stage.beacon = Number(beacon[1]) - 1;
            }
            else if (commodity) {
                stage.commodity = commodity[1];
            }
            else if (where) {
                fail(i, `"${where}" is not a place: leave it empty, or write "beacon <1-3>" or "commodity <ore|cells|relics>"`);
            }
            out.stages.push(stage);
        }
        else if (line) {
            paragraph.push(line);
        }
        else if (paragraph.length) {
            out.story.push(paragraph.join(' '));
            paragraph = [];
        }
    }
    if (paragraph.length) {
        out.story.push(paragraph.join(' '));
    }
    if (!out.title || (out.world < 0) || !out.stages.length) {
        fail(0, 'a mission needs a "# title", a "World: … · Reward: …" line and at least one stage row');
    }
    out.description = out.story[0] || '';
    return out;
}

// The eight worlds' names, in order, as src/js/worlds/*.js name them
function world_names()
{
    const order = ['haven', 'verdant', 'dustfall', 'ion_reach', 'obsidian', 'cryosphere', 'nova_forge', 'eclipse'];
    return order.map(v => fs.readFileSync(path.join(src_dir, 'js', 'worlds', `${v}.js`), 'utf8').match(/^\s+name: '([^']+)'/m)[1]);
}
