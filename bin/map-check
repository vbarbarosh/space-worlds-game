#!/usr/bin/env node

const cli = require('@vbarbarosh/node-helpers/src/cli');
const path = require('node:path');
const {chromium} = require('playwright');

const page_file = path.join(__dirname, '..', 'build', 'dev.html');
const modes = [
    {value: '', label: 'campaign'},
    {value: '&screen=arcade', label: 'arcade'},
    // an arcade Scroll run's long world, stretched along its lane (src/js/arcade_shapes.js), without the worlds' tricks
    // (src/js/arcade_base.js)
    {value: '&screen=arcade&kind=scroll', label: 'scroll'},
];
const usage = `usage: bin/map-check

    Opens every world of build/dev.html in the campaign, in the arcade and on its Scroll lanes, reads the map the game generated
    (window.dev_state) and checks it against docs/placement.md: R's docking and jumping ranges and the portals'
    rings never touch, gates face the worlds they lead to and stand far out, portal pairs span a real distance and
    keep apart from each other and the station, no gravity well or solid lies on any of them; the campaign's race
    courses (js/race.js) keep their rings and start line out of every range, rock and pull, their legs off gravity,
    portals and the station, and turn at each ring; the Races mode's Turbo track of each difficulty (js/race_rail.js)
    keeps its width clear of structures, gates, beacons and pulls; arcade Dustfall's cliffs and the rubble each leaves
    once it falls stand a ship's width clear of the station, gates, portals and beacons, as every solid; Ion Reach's
    arc pylons and charge fields (js/ion_pylons.js) are there, and their reach keeps out of the station's shelter, 150 m
    beyond every range, out of the pulls and the storms, a pylon's 400 m from another's, and no race ring in one;
    Obsidian's magnetic spires (js/obsidian_spires.js) are there, their field keeps out of the same, 300 m from
    another's, their solid body a ship's width clear of every rock, and no race ring or leg crosses a field. A world
    with a map file of src/maps/ is checked on the map the file makes, as the game flies it; the rules themselves
    are src/js/dev/map_rules.js, which the map editor of build/dev.html runs too.
    Exits 1 on any failure.`;

cli(main);

async function main()
{
    if (process.argv.length > 2) {
        console.log(usage);
        process.exit(2);
    }
    const browser = await chromium.launch();
    const failures = [];
    try {
        const page = await browser.newPage({viewport: {width: 1280, height: 720}});
        // a page error counts as a failure and is said where it happens (it was counted and never shown)
        page.on('pageerror', function (v) {
            console.log(`FAIL page error: ${v.stack || v.message}`);
            failures.push(`page error: ${v.message}`);
        });
        for (const mode of modes) {
            for (let world = 0; world < 8; ++world) {
                await page.goto(`file://${page_file}?world=${world}${mode.value}`);
                await page.waitForFunction(v => window.dev_state?.().player && (window.dev_state().arcade === v), !!mode.value);
                // the rules run in the page (src/js/dev/map_rules.js), as the map editor runs them, on the map read
                const {map, found} = await page.evaluate(function () {
                    const map = window.dev_state();
                    return {map, found: window.dev_map_check(map)};
                });
                if (!map.arcade) {
                    const tracks = await page.evaluate(() => window.dev_turbo_tracks());
                    found.push(...tracks.filter(v => v.room !== 0.6).map(v => `turbo track (${v.level}): clear across ${(v.room === null) ? 'none' : v.room} of its width, need 0.6`));
                }
                const title = `${mode.label} ${world + 1} ${map.world_name}`;
                const pylons = map.pylons.length ? `, ${map.pylons.length} arc pylons, ${map.charge_fields.length} charge fields` : '';
                const spires = map.spires.length ? `, ${map.spires.length} magnetic spires` : '';
                // a map file packed into the page is what the game flies (src/maps/)
                const file = map.map_file ? `, map file ${map.map_file}` : '';
                console.log(`${found.length ? 'FAIL' : 'ok  '} ${title.padEnd(22)} ${map.gates.length} gates, ${map.portals.length} portals${map.arcade ? '' : `, ${map.races.filter(Boolean).length} race courses`}${pylons}${spires}${file}${found.length ? `\n     ${found.join('\n     ')}` : ''}`);
                failures.push(...found.map(v => `${title}: ${v}`));
            }
        }
    }
    finally {
        await browser.close();
    }
    console.log(failures.length ? `${failures.length} failures` : 'all maps pass');
    if (failures.length) {
        process.exit(1);
    }
}
