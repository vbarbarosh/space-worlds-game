#!/usr/bin/env node

const cli = require('@vbarbarosh/node-helpers/src/cli');
const fs = require('node:fs');
const path = require('node:path');
const {chromium} = require('playwright');

const data_dir = path.join(__dirname, '..', 'data', 'playtest');
const kinds = ['free', 'scroll'];
const modes = ['chill', 'normal', 'overload'];
const picks = ['boon', 'gamble', 'trade', 'random', 'none'];
const routes = ['low', 'high', 'random'];
// The bot's builds (--build), each on the same small core (Prism 1, Phase armor 1, Shield capacitor 1): mixed, the
// default, Prism and Hotter plasma first with armour and the shield between; guns, Hotter plasma, Rapid resonance and
// Prism; tank, armour, shield, drones and nanites; evasion, the Evasive thrusters, Slipstream, the pulse and the generator
const builds = {
    mixed: [
        'spread', 'damage', 'armor', 'shield', 'damage', 'spread', 'armor', 'damage', 'shield', 'armor', 'damage', 'shield',
        'damage', 'rate', 'drone', 'nanites', 'rate', 'drone', 'nanites', 'pulse', 'rate', 'drone', 'nanites', 'pulse',
        'reactor', 'cooling', 'evasive', 'pulse', 'reactor', 'cooling', 'evasive', 'reactor', 'cooling', 'evasive',
    ],
    guns: ['spread', 'armor', 'shield', 'damage', 'damage', 'rate', 'spread', 'damage', 'rate', 'damage', 'rate', 'damage'],
    tank: [
        'spread', 'armor', 'shield', 'armor', 'shield', 'drone', 'nanites', 'armor', 'shield', 'drone', 'nanites', 'drone',
        'nanites', 'damage', 'damage',
    ],
    evasion: [
        'spread', 'armor', 'shield', 'evasive', 'pulse', 'reactor', 'evasive', 'speed', 'pulse', 'reactor', 'evasive',
        'speed', 'pulse', 'reactor', 'dash', 'speed', 'homing', 'homing', 'dash',
    ],
};
const usage = `usage: bin/playtest [--mode=normal] [--kind=free] [--seeds=1,2,3] [--label=name] [--page=build/index.html] [--minutes=20] [--gun=id] [--pick=boon] [--route=low] [--build=mixed|guns|tank|evasion|key,...] [--idle]

    A bot plays arcade runs of build/index.html (a copy with a hook, in data/playtest/) in Chromium, on a virtual
    clock and a seeded Math.random, as fast as the machine allows, and counts per world and wave what a run costs.

    How it flies: it holds 320 m from the nearest raider and circles it, steps aside from shots coming at it, picks
    up salvage when fewer than three raiders are close, then goes for the nearest of Verdant's brood nests and circles
    it close enough for its guns to take the nest (src/js/arcade_nests.js), goes for Haven's hauler while one is out
    and circles it (src/js/arcade_haulers.js; a world's entry keeps the cargo it saved), leads Dustfall's juggernaut
    across the zone of the nearest standing cliff and waits clear of it for the guns to take the crack
    (src/js/arcade_juggernauts.js; a world's entry keeps the juggernauts buried and ground down), waits by the
    station when no raider and no nest is left, keeps off the radiation
    at the edge (on a Scroll lane, off the view's edges, and the salvage it picks up is in the view), out of black
    holes' pulls and Ion Reach's arc pylons' rings (it does not seek the charge fields), off Obsidian's magnetic
    spires (it does not seek their cover); a flagship's
    duel it flies as its pilot says (boss_duel_pilot). The pulse at three raiders within 380 m, the push wave at four
    within 400 m, a dash past a missile within 220 m, the EMP at six within 550 m or below a third of its hull, stasis at
    eight, a repair kit below half. At the depot: a repair below 75% hull, two repair kits, then the build its reactor's power holds (src/js/arcade_power.js:
    Hotter plasma, Phase armor, the shield, Prism, Rapid resonance, then drones, nanites, the pulse, reactor, cooling,
    evasion), each level in its order that fits the power left; once that is bought, a sturdier ship on sale with no
    fewer mounts (more power) and one more of its gun for each empty mount, then the levels the next two worlds' power
    will hold; then it takes out what is not in the build and installs the build. EMPs up to three. Guns fire by
    themselves.

    A death with lives left starts the world again from its first wave, as the game's Retry does (arcade_retry); the
    last of the run's lives (arcade_lives, 3) ends it lost, as it ends the game's run. The run says when the shop ran
    out (the Aurora Cruiser owned and every module level owned, a launcher's modules only with the launcher): the
    minute and the world. Results go to data/playtest/<label>/<mode>-<seed>.json (<mode>-scroll-<seed>.json for a
    Scroll run), and a table per run is printed.

    --kind plays the arcade's Free runs (the default) or its Scroll runs, on a screen that moves on by itself, built
    up from chasers and passers (src/js/arcade_scroll.js, src/js/arcade_base.js).

    --minutes stops a run that takes longer than that on the wall clock, and says so.
    --gun buys that gun (plasma, scatter, ion, rail, missile, beam) at the first depot that can pay for it after a
    repair, before any module, with the cheapest ship that has a mount for it when yours has none; a sturdier ship
    later is one that still carries it.

    At each break between worlds (src/js/arcade_break.js) it takes a card and chooses the next world:
    --pick takes the boon, the gamble or the trade-off (another when it cannot pay for it), a card at random, or
    none (the break's card skipped, as the game before cards was); --route takes the lower world offered (today's
    order), the higher, or one at random.

    --build picks the bot's build (mixed, the default; guns; tank; evasion: see the builds in this file), or gives its
    own order: module keys, a key a level (damage,damage,armor is Hotter plasma 1 and 2, then Phase armor 1).

    --idle flies with no key pressed: no steering, dodge, dash, pulse, EMP, stasis or repair kit, the ship left to its
    guns' fire and, on a Scroll lane, to the screen's back edge carrying it on; the depot and the break go as above.
    Its results go to data/playtest/<mode>-idle/ unless --label says otherwise.

    Under each run's table, its interest: per world, how the fight builds and lets go, how long nothing happens, how long
    nothing new comes, the choices and close calls, as a score 0 to 100 (docs/interest.md).`;

cli(main);

async function main()
{
    const options = Object.fromEntries(process.argv.slice(2).map(v => v.replace(/^--/, '').split('=')));
    if (Object.keys(options).some(v => !['mode', 'kind', 'seeds', 'label', 'page', 'minutes', 'gun', 'pick', 'route', 'build', 'idle'].includes(v)) || (options.idle !== undefined) || !kinds.includes(options.kind || 'free') || !picks.includes(options.pick || 'boon') || !routes.includes(options.route || 'low')) {
        console.log(usage);
        process.exit(2);
    }
    const mode = options.mode || 'normal';
    const kind = options.kind || 'free';
    const seeds = (options.seeds || '1').split(',').map(Number);
    const minutes = Number(options.minutes || 20);
    // --idle takes no value: the bot presses no key while flying
    const idle = 'idle' in options;
    if (!modes.includes(mode) || seeds.some(v => !Number.isInteger(v))) {
        console.log(usage);
        process.exit(2);
    }
    const out_dir = path.join(data_dir, options.label || (idle ? `${mode}-idle` : mode));
    fs.mkdirSync(out_dir, {recursive: true});
    const html = fs.readFileSync(options.page || path.join(__dirname, '..', 'build', 'index.html'), 'utf8');
    const at = html.lastIndexOf('})();');
    const hooked = path.join(data_dir, `index-hooked-${process.pid}.html`);
    fs.writeFileSync(hooked, `${html.slice(0, at)}window.__t = function (code) { return eval(code); };\n${html.slice(at)}`);
    const browser = await chromium.launch();
    const context = await browser.newContext({viewport: {width: 1920, height: 1080}, deviceScaleFactor: 1});
    const runs = [];
    try {
        for (const seed of seeds) {
            const page = await context.newPage();
            page.on('pageerror', v => console.error(`seed ${seed}: ${v.message}`));
            await page.addInitScript(page_clock);
            await page.goto(`file://${hooked}`);
            await page.waitForTimeout(400);
            await page.evaluate(v => window.__t(v), `(${page_bot})(${JSON.stringify({mode, kind, seed, gun: options.gun || null, pick: options.pick || 'boon', route: options.route || 'low', idle, build: builds[options.build || 'mixed'] || options.build.split(',')})})`);
            const time0 = Date.now();
            while (!await page.evaluate(() => window.__bot.done) && (Date.now() - time0 < minutes*60000)) {
                await page.waitForTimeout(1000);
            }
            const run = await page.evaluate(() => window.__bot.report());
            run.wall_seconds = Math.round((Date.now() - time0)/1000);
            run.cut = !run.done;
            for (const world of run.worlds) {
                world.interest = interest_of(world);
            }
            fs.writeFileSync(path.join(out_dir, `${mode}-${(kind === 'free') ? '' : `${kind}-`}${seed}.json`), JSON.stringify(run, null, 1));
            console.log(run_table(run));
            console.log(interest_table(run));
            runs.push(run);
            await page.close();
        }
    }
    finally {
        await browser.close();
        fs.rmSync(hooked);
    }
    console.log(out_dir);
}

// A run as a table: a row per world, then the run's end
function run_table(run)
{
    const maxed = run.maxed ? `shop ran out at ${(run.maxed.run_time/60).toFixed(1)} min in ${run.maxed.world}` : 'shop never ran out';
    const lines = [`${run.mode}${(run.kind === 'free') ? '' : ` ${run.kind}`}${run.idle ? ' idle' : ''} seed ${run.seed}: ${run.won ? 'won' : run.cut ? 'cut (time)' : 'lost'} · ${run.deaths} deaths · ${Math.round(run.run_time)} s · score ${run.score} · salvage left ${run.salvage_left} · ${maxed} · ${run.wall_seconds} s on the clock`];
    lines.push(`cards ${run.pick}: ${(run.cards || []).join(', ') || '-'} · route ${run.route_how}: ${(run.route || []).join(' > ')}`);
    lines.push('world        hull lost (w1/w2/w3)   all dmg  kills  off-screen  salvage at depot  left after  power  deaths  time  quiet  crowd  pulses  flagship  ship and guns  most from');
    for (const world of run.worlds) {
        const hull = world.waves.map(v => Math.round(v.hull)).join(' / ');
        const all = Math.round(world.waves.reduce((sum, v) => sum + v.hull + v.shield, 0));
        const sources = Object.entries(world.sources).sort((a, b) => b[1] - a[1]).slice(0, 2).map(v => `${v[0]} ${Math.round(v[1])}`).join(', ');
        // left after: the module levels and ships still to buy, and the salvage kept, after the depot
        const left = (world.levels_left === undefined) ? '-' : `${world.levels_left}+${world.ships_left} ◆${world.salvage_after_depot}`;
        // the flagship: the seconds it lived and the hull you lost meanwhile, over every try; how it ended
        const f = world.flagship;
        const flagship = f.time ? `${Math.round(f.time)} s ${Math.round(f.hull)} hp${f.escaped ? ' fled' : ''}` : '-';
        // the power the build draws after the depot, and what the reactor holds
        const power = world.power ? `${world.power[0]}/${world.power[1]}` : '-';
        // waves 1 and 2: the seconds with under 3 raiders in play, and how many are in play on average
        const quiet = `${Math.round(world.quiet || 0)} s`;
        const crowd = world.wave_time ? (world.crowd/world.wave_time).toFixed(1) : '-';
        lines.push(`${world.name.padEnd(12)} ${hull.padEnd(22)} ${String(all).padStart(7)}  ${String(world.kills).padStart(5)}  ${String(world.off_screen).padStart(10)}  ${String(world.salvage_at_depot ?? '-').padStart(16)}  ${left.padStart(10)}  ${power.padStart(5)}  ${String(world.deaths).padStart(6)}  ${Math.round(world.time)} s  ${quiet.padStart(5)}  ${crowd.padStart(5)}  ${String(world.pulses ?? 0).padStart(6)}  ${flagship.padStart(8)}  ${world.ship}: ${world.guns.join('+')}  ${sources}`);
    }
    return lines.join('\n');
}

// How interesting a world was to fly, from its samples and news (docs/interest.md): tension a second, from the raiders
// close by and the hull and shield lost in the last 3 s, low hull adding to it, smoothed over 5 s; its peaks (up past
// 0.65 after a fall under 0.35), how much it varies, how high the flagship's part stands over the rest; the share of
// seconds with no raider within 900 m (dead) and the longest stretch under 0.2 (lull); the longest gap with nothing new
// (news); the choices offered; close calls (the hull under 30% and back over 50% with no death); the longest gap with
// no kill and no salvage. Each against its aim, as a score 0 to 100 (interest_aims).
function interest_of(world)
{
    const trace = world.trace || [];
    if (trace.length < 10) {
        return null;
    }
    const raw = trace.map(function (v, i) {
        const lost = trace.slice(Math.max(0, i - 2), i + 1).reduce((sum, vv) => sum + vv.lost, 0);
        return Math.min(1, 0.55*Math.min(1, v.n/8) + 0.45*Math.min(1, lost/0.12) + ((v.hp < 0.35) ? 0.25 : 0));
    });
    const tension = raw.map((v, i) => mean(raw.slice(Math.max(0, i - 2), i + 3)));
    let peaks = 0;
    let armed = true;
    for (const v of tension) {
        if (armed && (v > 0.65)) {
            peaks++;
            armed = false;
        }
        else if (v < 0.35) {
            armed = true;
        }
    }
    const flagship = tension.filter((v, i) => trace[i].f);
    const before = tension.filter((v, i) => !trace[i].f);
    const minutes = trace.length/60;
    let lull = 0;
    let run = 0;
    for (const v of tension) {
        run = (v < 0.2) ? run + 1 : 0;
        lull = Math.max(lull, run);
    }
    const times = [0, ...(world.news || []).map(v => v.t), trace.length];
    const news_gap = Math.max(...times.slice(1).map((v, i) => v - times[i]));
    let close = 0;
    let low = false;
    for (const v of trace) {
        if (v.hp < 0.3) {
            low = v.d;
        }
        else if ((low !== false) && (v.hp > 0.5)) {
            close += (low === v.d) ? 1 : 0;
            low = false;
        }
    }
    let reward_gap = 0;
    run = 0;
    for (const v of trace) {
        run = (v.k || v.e) ? 0 : run + 1;
        reward_gap = Math.max(reward_gap, run);
    }
    const out = {
        minutes: Number(minutes.toFixed(1)),
        mean: round2(mean(tension)),
        spread: round2(Math.sqrt(mean(tension.map(v => (v - mean(tension))**2)))),
        peaks_per5: Number((peaks*5/minutes).toFixed(1)),
        climax: before.length && flagship.length ? round2(mean(flagship)/Math.max(0.05, mean(before))) : null,
        dead: round2(trace.filter(v => v.far).length/trace.length),
        lull,
        news: (world.news || []).length,
        news_gap,
        choices_per5: Number(((world.choices || 0)*5/minutes).toFixed(1)),
        close_per5: Number((close*5/minutes).toFixed(1)),
        reward_gap,
        curve: tension.filter((v, i) => !(i % 5)).map(round2),
    };
    out.score = interest_score(out);
    return out;
}

// Each measure's part of the score, 0 to 1 against its aim: peaks 3 to 7 in five minutes (Left 4 Dead's director: a
// build-up, a peak and a rest about once a minute); tension that varies (0.22 or more); the flagship's part 1.3 times
// the rest or more (Schell's interest curve: the climax at the end); 5% of the time or less with nothing to fight;
// something new at least every 45 s; three choices in five minutes; a close call or two; the score their mean
function interest_score(v)
{
    const peaks = (v.peaks_per5 >= 3) && (v.peaks_per5 <= 7) ? 1 : (v.peaks_per5 > 7) ? 0.7 : v.peaks_per5/3;
    const parts = [
        peaks,
        Math.min(1, v.spread/0.22),
        (v.climax === null) ? 0 : clamp01((v.climax - 0.9)/0.4),
        clamp01(1 - (v.dead - 0.05)/0.25),
        clamp01((90 - v.news_gap)/45),
        Math.min(1, v.choices_per5/3),
        Math.min(1, v.close_per5/2),
    ];
    return Math.round(100*mean(parts));
}

// A run's interest as a table: a row per world, and the run's mean score
function interest_table(run)
{
    const lines = ['interest     score  tension (mean spread)  peaks/5min  climax  dead  lull  news (most s apart)  choices/5min  close/5min  no reward'];
    const scored = run.worlds.filter(v => v.interest);
    for (const world of scored) {
        const v = world.interest;
        lines.push(`${world.name.padEnd(12)} ${String(v.score).padStart(5)}  ${`${v.mean} ${v.spread}`.padEnd(21)}  ${String(v.peaks_per5).padStart(10)}  ${String(v.climax ?? '-').padStart(6)}  ${`${Math.round(v.dead*100)}%`.padStart(4)}  ${`${v.lull} s`.padStart(4)}  ${`${v.news} (${v.news_gap} s)`.padStart(19)}  ${String(v.choices_per5).padStart(12)}  ${String(v.close_per5).padStart(10)}  ${`${v.reward_gap} s`.padStart(9)}`);
    }
    lines.push(`run's interest: ${scored.length ? Math.round(mean(scored.map(v => v.interest.score))) : '-'}`);
    return lines.join('\n');
}

function mean(values)
{
    return values.length ? values.reduce((sum, v) => sum + v, 0)/values.length : 0;
}

function round2(v)
{
    return Math.round(v*100)/100;
}

function clamp01(v)
{
    return Math.max(0, Math.min(1, v));
}

function page_clock()
{
    let seed = 12345;
    window.__seed = function (v) {
        seed = v;
    };
    Math.random = function () {
        seed = (seed + 0x6d2b79f5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0)/4294967296;
    };
    localStorage.clear();
    const request = window.requestAnimationFrame.bind(window);
    window.__vt = 0;
    window.requestAnimationFrame = function (callback) {
        return request(() => callback(window.__vt));
    };
}

// Runs inside the game's scope: starts an arcade run and plays it, 60 frames of game time per frame of the page and
// nothing drawn, the bot pressing keys and buying at the depot, until the run is won or lost
function page_bot(options)
{
    window.__seed(options.seed*7919);
    clock = 0;
    time = 0;
    ui_timer = 0;
    difficulty = options.mode;
    const B = {done: false, deaths: 0, worlds: [], world: null, snapshot: null, won: false, maxed: null, cards: []};
    window.__bot = B;
    // The build: module levels in the order the bot wants them installed, a key a level (its n-th time is level n); the
    // reactor's power (src/js/arcade_power.js) takes them from the front, a level that does not fit giving its place
    // to the next that does. --build names one of these (mixed by default) or gives its own list.
    const build = options.build;
    // the shop ran out: the top ship, every module at its cap (a launcher's modules only with the launcher)
    function maxed_check() {
        const done = ensure_career().ships.includes('cruiser') && upgrade_options.every(v => (module_owned(v.key) >= v.cap) || module_needs_gun(v));
        if (done && !B.maxed) {
            B.maxed = {run_time, world: worlds[campaign.world].name};
        }
    }
    function world_entry() {
        const current = B.worlds[B.worlds.length - 1];
        if (current && (current.world === campaign.world)) {
            return current;
        }
        const out = {world: campaign.world, name: worlds[campaign.world].name, ship: current_ship().id, guns: mounted_weapons().map(v => (v ? v.id : 'empty')), waves: [], sources: {}, flagship: {time: 0, hull: 0, escaped: false}, kills: 0, off_screen: 0, deaths: 0, time: 0, quiet: 0, crowd: 0, wave_time: 0, pulses: 0, pushes: 0, salvage_at_depot: null, earned: {}, trace: [], news: [], choices: 0};
        B.worlds.push(out);
        return out;
    }
    function wave_entry() {
        const entry = world_entry();
        const n = Math.max(1, arcade.wave);
        while (entry.waves.length < n) {
            entry.waves.push({hull: 0, shield: 0});
        }
        return entry.waves[n - 1];
    }
    // each death in a world: when, what hit you last, and the nearest black hole's distance (a crossed horizon ends a
    // ship at any hull: map.js)
    const base_finish = finish;
    finish = function (won, ...rest) {
        if (!won && arcade.active && player && (state === 'playing')) {
            const hole = black_holes.reduce((a, v) => (!a || (distance(v, player) < distance(a, player))) ? v : a, null);
            world_entry().death_log = (world_entry().death_log || []).concat([{t: Math.round(world_entry().time), wave: arcade.wave, hp: Math.round(player.hp), hole: hole ? Math.round(distance(hole, player)) : null, core: hole ? Math.round(hole.core) : null, last: B.last_hit || null}]);
        }
        return base_finish(won, ...rest);
    };
    const base_damage_player = damage_player;
    damage_player = function (...args) {
        const hp0 = player.hp;
        const shield0 = player.shield || 0;
        base_damage_player(...args);
        if (arcade.active && player) {
            const entry = wave_entry();
            const lost = Math.max(0, hp0 - player.hp) + Math.max(0, shield0 - (player.shield || 0));
            entry.hull += Math.max(0, hp0 - player.hp);
            entry.shield += Math.max(0, shield0 - (player.shield || 0));
            if (enemies.some(v => (v.type === 'boss') && (v.hp > 0))) {
                world_entry().flagship.hull += Math.max(0, hp0 - player.hp);
            }
            // where the hit came from: the function that called damage_player, and from the update a ram or a shot and
            // the raider's type
            const cause = (typeof args[2] === 'string') ? ` ${args[2]}${args[3]?.type ? ` ${args[3].type}` : (args[3]?.from ? ` ${args[3].from}` : '')}` : '';
            const caller = new Error().stack.split('\n').slice(2, 4).map(v => v.trim().split(' ')[1]).join('<') + cause;
            const sources = world_entry().sources;
            sources[caller] = (sources[caller] || 0) + lost;
            B.last_hit = caller;
            B.second.lost += lost;
        }
    };
    // the salvage each world brought in, by where it came from (pickups, world bonus)
    const base_earn = play_log_earn;
    play_log_earn = function (source, amount) {
        base_earn(source, amount);
        if (arcade.active) {
            const earned = world_entry().earned;
            earned[source] = (earned[source] || 0) + amount;
            B.second.earned += amount;
        }
    };
    const base_kill = base_damage_enemy;
    base_damage_enemy = function (enemy, damage) {
        const alive = enemy.hp > 0;
        base_kill(enemy, damage);
        if (alive && (enemy.hp <= 0) && arcade.active) {
            const entry = world_entry();
            entry.kills++;
            const seen = (enemy.x > camera.x) && (enemy.x < camera.x + W/zoom) && (enemy.y > camera.y) && (enemy.y < camera.y + H/zoom);
            entry.off_screen += seen ? 0 : 1;
            B.second.kills++;
        }
    };
    // a wave event: news, and a convoy or an ace a prize to go for or leave (interest_of's choices)
    const base_event_start = arcade_event_start;
    arcade_event_start = function () {
        base_event_start();
        if (arcade.event) {
            news(`event ${arcade.event.kind}`);
            world_entry().choices += ['convoy', 'ace'].includes(arcade.event.kind) ? 1 : 0;
        }
    };
    // a headline (src/js/arcade_news.js): news
    const base_headline = news_headline;
    news_headline = function (kind) {
        base_headline(kind);
        news(`headline ${kind}`);
    };
    // The interest measures (interest_of in this file): what the second now ending brought, and the first time each
    // new thing shows in a world (news): a raider type close by, an elite apart, an event, the flagship and its second
    // half
    B.second = {lost: 0, kills: 0, earned: 0, frames: 0};
    function news(what) {
        const entry = world_entry();
        if (!entry.news.some(v => v.what === what)) {
            entry.news.push({t: Math.round(entry.time), what});
        }
    }
    // a second of a world's time as a sample: raiders within 700 m (a flagship as 4), whether none is within 900 m, the
    // hull and shield lost as a share of both full, kills, salvage earned, the hull's share, the wave, a flagship
    // alive, the deaths in this world so far
    function interest_sample() {
        const entry = world_entry();
        // Haven's hauler (src/js/arcade_haulers.js) and Dustfall's juggernaut (src/js/arcade_juggernauts.js) are
        // anchored, as each flies its own way, and are raiders to fight
        const alive = enemies.filter(v => (v.hp > 0) && (!v.anchor || (v.hauler === 'tug') || v.juggernaut));
        for (const v of alive) {
            if (distance(v, player) < 900) {
                news((v.type === 'boss') ? ((v.hp < v.max_hp*0.5) ? 'flagship half' : 'flagship') : `${v.elite ? 'elite ' : ''}${v.job ? v.job.kind : v.type}`);
            }
        }
        B.second.frames++;
        if (B.second.frames < 60) {
            return;
        }
        const near = alive.reduce((n, v) => n + ((distance(v, player) < 700) ? ((v.type === 'boss') ? 4 : 1) : 0), 0);
        const far = !alive.some(v => distance(v, player) < 900);
        const lost = B.second.lost/(hull_max() + shield_max());
        entry.trace.push({t: Math.round(entry.time), n: near, far: far ? 1 : 0, lost: Number(lost.toFixed(3)), k: B.second.kills, e: B.second.earned, hp: Number((player.hp/hull_max()).toFixed(2)), w: arcade.wave, f: alive.some(v => v.type === 'boss') ? 1 : 0, d: entry.deaths, c: combo, s: (typeof streak === 'object') ? streak.count : 0, g: (typeof streak === 'object') ? streak.grazes : 0});
        B.second = {lost: 0, kills: 0, earned: 0, frames: 0};
    }
    function steer(dx, dy) {
        keys.clear();
        const d = Math.hypot(dx, dy) || 1;
        if (dx/d > 0.38) {
            keys.add('KeyD');
        }
        if (dx/d < -0.38) {
            keys.add('KeyA');
        }
        if (dy/d > 0.38) {
            keys.add('KeyS');
        }
        if (dy/d < -0.38) {
            keys.add('KeyW');
        }
    }
    function fly() {
        // --idle: no key at all, the guns firing by themselves
        if (options.idle) {
            keys.clear();
            return;
        }
        // an anchored raider (a flagship's nest) is the duel's (below), not one to circle
        const alive = enemies.filter(v => (v.hp > 0) && !v.anchor);
        function near(r) {
            return alive.filter(v => distance(v, player) < r).length;
        }
        const nearest = alive.reduce((best, v) => (!best || (distance(v, player) < distance(best, player))) ? v : best, null);
        let dx = 0;
        let dy = 0;
        if (nearest) {
            const d = distance(nearest, player);
            const ux = (nearest.x - player.x)/d;
            const uy = (nearest.y - player.y)/d;
            const toward = (d > 360) ? 1 : (d < 280) ? -1 : 0;
            dx = ux*toward - uy*0.8;
            dy = uy*toward + ux*0.8;
        }
        // shots coming at the ship within 160 m: a step across their line
        let dodge = null;
        for (const v of hostile) {
            const ox = player.x - v.x;
            const oy = player.y - v.y;
            const d = Math.hypot(ox, oy);
            if ((d < 160) && ((ox*(v.vx || 0) + oy*(v.vy || 0)) > 0)) {
                const s = Math.hypot(v.vx || 0, v.vy || 0) || 1;
                dodge = {x: -(v.vy || 0)/s, y: (v.vx || 0)/s};
                dx += dodge.x*1.5;
                dy += dodge.y*1.5;
                break;
            }
        }
        // a missile closing in: a dash past it, as a player does with Shift
        if (hostile.some(v => v.missile && (distance(v, player) < 220))) {
            dash();
        }
        // on a Scroll lane (src/js/arcade_scroll.js) only what is in the view can be reached, and with nothing to do
        // it waits in the view's back half
        const lane = arcade_scroll_on();
        const vw = W/zoom;
        const vh = H/zoom;
        // Verdant's brood nests (src/js/arcade_nests.js), where the build has them: with room (fewer than three raiders
        // close and none inside its own distance) it goes for a standing one, as a pilot follows the arrow to it, and
        // picks up only the salvage within 350 m on the way: the nest it has burnt most, as a pilot finishes the one
        // he began, else the nearest; while a burnt nest's brood is out it fights the brood first
        const brood_out = arcade.active && !!arcade.pace?.crest && (arcade.pause <= 0);
        const nests = ((typeof brood_nests === 'object') && !brood_out) ? brood_nests.filter(v => v.rock) : [];
        const begun = nests.filter(v => v.rock.hp < v.rock.max_hp).sort((a, b) => a.rock.hp - b.rock.hp)[0];
        const nest = begun || nests.reduce((best, v) => (!best || (distance(v, player) < distance(best, player))) ? v : best, null);
        if (near(600) < 3) {
            const reach = lane ? pickups.filter(v => !arcade_scroll_unseen(v)) : pickups;
            const pickup = reach.reduce((best, v) => (!best || (distance(v, player) < distance(best, player))) ? v : best, null);
            if (pickup && (distance(pickup, player) < (nest ? 350 : 900))) {
                dx = pickup.x - player.x;
                dy = pickup.y - player.y;
            }
            else if (nest && !(nearest && (distance(nearest, player) < 280))) {
                // far off, straight for it; then round it 110 to 190 m off its rim, nearer than its own distance from a
                // raider, so the guns take the nest; a shot coming at it still gets its step aside
                const d = Math.max(1, distance(nest, player));
                const gap = d - nest.r;
                const toward = (gap > 190) ? 1 : (gap < 110) ? -1 : 0;
                const round = (gap > 600) ? 0 : 0.8;
                dx = ((nest.x - player.x)/d)*toward - ((nest.y - player.y)/d)*round;
                dy = ((nest.y - player.y)/d)*toward + ((nest.x - player.x)/d)*round;
                if (dodge) {
                    dx += dodge.x*1.5;
                    dy += dodge.y*1.5;
                }
            }
            else if (!nearest && lane) {
                const view = arcade_scroll_view();
                dx = view.x - arcade_scroll.way.x*view.h*0.4 - player.x;
                dy = view.y - arcade_scroll.way.y*view.h*0.4 - player.y;
            }
            else if (!nearest) {
                dx = station.x - player.x;
                dy = station.y - player.y;
            }
        }
        // Haven's haulers (src/js/arcade_haulers.js), where the build has them: it goes for the hauler out, as a pilot
        // follows the card's arrow, whatever fights round it, unless a raider is within 200 m; far off, straight for it;
        // then round it 150 to 260 m off, so the guns take it and its string, keeping off the rocks on the way; the
        // salvage its containers throw out within 250 m it picks up first, with fewer than three raiders close
        const hauler = ((typeof hauler_run === 'object') && hauler_run.ship && (hauler_run.ship.hp > 0)) ? hauler_run.ship : null;
        if (typeof hauler_run === 'object') {
            world_entry().cargo = (campaign.world === hauler_world) ? hauler_run.saved : world_entry().cargo;
        }
        if (hauler && !(nearest && (nearest !== hauler) && (distance(nearest, player) < 200))) {
            const loot = (near(400) < 3) ? pickups.reduce((best, v) => (!best || (distance(v, player) < distance(best, player))) ? v : best, null) : null;
            if (loot && (distance(loot, player) < 250)) {
                dx = loot.x - player.x;
                dy = loot.y - player.y;
            }
            else {
                const d = Math.max(1, distance(hauler, player));
                const gap = d - hauler.r;
                const toward = (gap > 260) ? 1 : (gap < 150) ? -1 : 0;
                const round = (gap > 600) ? 0 : 0.8;
                dx = ((hauler.x - player.x)/d)*toward - ((hauler.y - player.y)/d)*round;
                dy = ((hauler.y - player.y)/d)*toward + ((hauler.x - player.x)/d)*round;
                // the chase crosses the map: away from a rock whose rim is within 110 m, harder the nearer, as a pilot
                // steers round what is ahead (as it was, rocks cost it twice the hull they did before the haulers)
                for (const v of ore_nodes) {
                    const gap = (v.hp > 0) ? distance(v, player) - v.r - player.r : Infinity;
                    if (gap < 110) {
                        dx += ((player.x - v.x)/distance(v, player))*2*(1 - Math.max(0, gap)/110);
                        dy += ((player.y - v.y)/distance(v, player))*2*(1 - Math.max(0, gap)/110);
                    }
                }
                if (dodge) {
                    dx += dodge.x*1.5;
                    dy += dodge.y*1.5;
                }
            }
        }
        // Dustfall's juggernauts (src/js/arcade_juggernauts.js), where the build has them: it leads the one out under
        // the standing cliff nearest it, as a pilot follows the card's arrow: to a place clear of the cliff's zone, past
        // the zone's middle from the juggernaut, so the juggernaut comes to it across the zone and the guns take the
        // crack; there it waits, stepping aside from shots; out of the lane of a charge it steps across; with no cliff
        // standing it circles the juggernaut 150 to 260 m off, so the guns grind it down; the salvage within 250 m it
        // picks up first, with fewer than three raiders close. A world's entry keeps the juggernauts buried and ground
        // down, the cliffs left and the seconds a juggernaut was out
        const juggernaut = ((typeof juggernaut_run === 'object') && juggernaut_run.ship && (juggernaut_run.ship.hp > 0)) ? juggernaut_run.ship : null;
        if ((typeof juggernaut_run === 'object') && (campaign.world === juggernaut_world)) {
            world_entry().buried = juggernaut_run.buried;
            world_entry().ground = juggernaut_run.ground;
            // the cliffs standing as the flagship's wave begins: its own fight fells them by its own rule
            world_entry().cliffs_left = (arcade.wave < arcade_free_waves) ? cliffs.filter(v => v.rock.hp > 0).length : world_entry().cliffs_left;
        }
        if (juggernaut) {
            // the seconds a juggernaut was out, and the longest one's
            world_entry().juggernaut_time = (world_entry().juggernaut_time || 0) + 1/60;
            B.juggernaut_out = (B.juggernaut_seen === juggernaut) ? B.juggernaut_out + 1/60 : 1/60;
            B.juggernaut_seen = juggernaut;
            world_entry().juggernaut_longest = Math.max(world_entry().juggernaut_longest || 0, B.juggernaut_out);
            const cliff = juggernaut_cliff_nearest();
            const charge = ['sign', 'charge'].includes(juggernaut_run.mode) ? juggernaut_run.lane : null;
            const off = (charge === null) ? Infinity : (player.x - juggernaut.x)*Math.sin(charge) - (player.y - juggernaut.y)*Math.cos(charge);
            const loot = (near(400) < 3) ? pickups.reduce((best, v) => (!best || (distance(v, player) < distance(best, player))) ? v : best, null) : null;
            if (Math.abs(off) < 140) {
                dx = ((off >= 0) ? 1 : -1)*Math.sin(charge);
                dy = ((off >= 0) ? -1 : 1)*Math.cos(charge);
            }
            else if (loot && (distance(loot, player) < 250)) {
                dx = loot.x - player.x;
                dy = loot.y - player.y;
            }
            else if (cliff) {
                const end = cliff.rock.r + cliff_reach;
                const middle = cliff_point(cliff, end*0.55, 0);
                const far = Math.max(1, distance(juggernaut, middle));
                const ux = (middle.x - juggernaut.x)/far;
                const uy = (middle.y - juggernaut.y)/far;
                let stand = middle;
                for (let step = 60; step <= 720; step += 30) {
                    stand = {x: middle.x + ux*step, y: middle.y + uy*step};
                    if (!cliff_zone_has(cliff, stand, player.r + cliff_aim_margin + 50)) {
                        break;
                    }
                }
                const d = distance(stand, player);
                dx = (d > 50) ? (stand.x - player.x)/d : 0;
                dy = (d > 50) ? (stand.y - player.y)/d : 0;
                if (dodge) {
                    dx += dodge.x*1.5;
                    dy += dodge.y*1.5;
                }
            }
            else {
                const d = Math.max(1, distance(juggernaut, player));
                const gap = d - juggernaut.r;
                const toward = (gap > 260) ? 1 : (gap < 150) ? -1 : 0;
                dx = ((juggernaut.x - player.x)/d)*toward - ((juggernaut.y - player.y)/d)*0.8;
                dy = ((juggernaut.y - player.y)/d)*toward + ((juggernaut.x - player.x)/d)*0.8;
                if (dodge) {
                    dx += dodge.x*1.5;
                    dy += dodge.y*1.5;
                }
            }
            // away from a rock whose rim is within 110 m, as on the hauler's chase; a cliff too
            for (const v of ore_nodes) {
                const gap = (v.hp > 0) ? distance(v, player) - v.r - player.r : Infinity;
                if (gap < 110) {
                    dx += ((player.x - v.x)/distance(v, player))*2*(1 - Math.max(0, gap)/110);
                    dy += ((player.y - v.y)/distance(v, player))*2*(1 - Math.max(0, gap)/110);
                }
            }
        }
        // a flagship's duel (src/js/boss_duels.js), where the build has one: with no raider close, or a plan to keep
        // to (firm), fly it as a pilot would: thrust toward the velocity it asks for, coast once there, and the pulse
        // where it says, still stepping across a shot's line as a player does while keeping to it
        const plan = (typeof boss_duel_pilot === 'function') ? boss_duel_pilot() : null;
        if (plan && ((near(500) === 0) || plan.firm)) {
            dx = plan.vx - player.vx;
            dy = plan.vy - player.vy;
            if (Math.hypot(dx, dy) < 30) {
                dx = 0;
                dy = 0;
            }
            if (dodge) {
                dx += dodge.x*400;
                dy += dodge.y*400;
            }
            if (plan.pulse && (player.energy >= 100)) {
                pulse();
            }
        }
        // a black hole's pull: away from it, unless the duel's plan keeps to the rim (it leans out against the pull
        // itself)
        if (!(plan && plan.firm)) {
            for (const hole of black_holes) {
                const d = Math.max(1, distance(hole, player));
                if (d < hole.radius*1.6) {
                    const s = Math.hypot(dx, dy) || 1;
                    dx = dx/s + ((player.x - hole.x)/d)*3;
                    dy = dy/s + ((player.y - hole.y)/d)*3;
                }
            }
        }
        // an arc pylon's ring (Ion Reach, src/js/ion_pylons.js): out of it, as a pilot struck once keeps out
        for (const v of pylons) {
            const d = Math.max(1, distance(v, player));
            if (d < pylon_reach + 80) {
                const s = Math.hypot(dx, dy) || 1;
                dx = dx/s + ((player.x - v.x)/d)*3;
                dy = dy/s + ((player.y - v.y)/d)*3;
            }
        }
        // a magnetic spire (Obsidian, src/js/obsidian_spires.js): out of its field, where its fire bends into the spire
        for (const v of spires) {
            const d = Math.max(1, distance(v, player));
            if (d < spire_reach + 40) {
                const s = Math.hypot(dx, dy) || 1;
                dx = dx/s + ((player.x - v.x)/d)*3;
                dy = dy/s + ((player.y - v.y)/d)*3;
            }
        }
        if (lane) {
            const edge = 160;
            dx += (player.x < camera.x + edge) ? 2 : (player.x > camera.x + vw - edge) ? -2 : 0;
            dy += (player.y < camera.y + edge) ? 2 : (player.y > camera.y + vh - edge) ? -2 : 0;
        }
        else {
            const edge = 420;
            dx += (player.x < edge) ? 2 : (player.x > world.w - edge) ? -2 : 0;
            dy += (player.y < edge) ? 2 : (player.y > world.h - edge) ? -2 : 0;
        }
        steer(dx, dy);
        if ((player.energy >= 100) && (near(380) >= 3)) {
            pulse();
        }
        if ((push_ring.charges > 0) && (near(400) >= 4)) {
            const charges = push_ring.charges;
            push_ring_fire();
            if (push_ring.charges < charges) {
                world_entry().pushes++;
            }
        }
        if (supplies.emp && ((near(550) >= 6) || ((player.hp < hull_max()/3) && near(550)))) {
            use_supply('emp');
        }
        if (supplies.stasis && (near(600) >= 8)) {
            use_supply('stasis');
        }
        if (supplies.medkit && (player.hp < hull_max()/2)) {
            use_supply('medkit');
        }
    }
    function buy(kind, id) {
        const item = arcade_depot_items().find(v => (v.kind === kind) && (v.id === id));
        if (!item || item.done || (item.price === null) || (salvage < item.price)) {
            return false;
        }
        arcade_depot_buy(`${kind}:${id}`);
        return true;
    }
    // The levels of the build the reactor holds now, a key a level: each in the build's order that is owned or on sale
    // and fits the power left; a module's level that does not fit leaves out its higher ones too. `more` power on top
    // plans the levels to buy ahead for the next worlds' power
    function build_plan(more = 0) {
        const out = [];
        const shut = new Set();
        let left = arcade_power_capacity() + more;
        const levels = {};
        for (const key of build) {
            const option = upgrade_options.find(v => v.key === key);
            const level = (levels[key] = (levels[key] || 0) + 1);
            if (shut.has(key) || (level > option.cap) || module_needs_gun(option)) {
                continue;
            }
            const owned = arcade.owned[key] >= level;
            const open = module_level_opens(option, level) <= world_reached();
            if ((!owned && !open) || (module_power(key) > left)) {
                shut.add(key);
                continue;
            }
            out.push(key);
            left -= module_power(key);
        }
        return out;
    }
    // the levels of a plan the bot does not own yet, bought in its order while the salvage lasts; true when all are
    function buy_plan(plan) {
        const seen = {};
        for (const key of plan) {
            seen[key] = (seen[key] || 0) + 1;
            if ((arcade.owned[key] < seen[key]) && !buy('module', key)) {
                return false;
            }
        }
        return true;
    }
    // the ship flies the plan: the levels past it out, then its levels in, by the depot's Remove and Install
    function install_plan(plan) {
        const want = {};
        for (const key of plan) {
            want[key] = (want[key] || 0) + 1;
        }
        const base = initial_upgrades();
        for (const option of upgrade_options) {
            while (upgrades[option.key] - base[option.key] > (want[option.key] || 0)) {
                arcade_depot_fit(`module:${option.key}`, 'out');
            }
        }
        for (const key of plan) {
            if (arcade_module_fitted(key) < want[key]) {
                arcade_depot_fit(`module:${key}`, 'in');
            }
        }
    }
    function shop() {
        world_entry().salvage_at_depot = salvage;
        if (player.hp < hull_max()*0.75) {
            buy('supply', 'repair');
        }
        if (options.gun && !ensure_career().weapons.includes(options.gun)) {
            // a gun no mount fits comes with the cheapest ship that takes it
            const gun = weapon_by_id(options.gun);
            if (!gun_fits_ship(gun)) {
                const ships = arcade_depot_items().filter(v => (v.kind === 'ship') && (v.price !== null) && gun_fits_ship(gun, ship_catalog.find(vv => vv.id === v.id)));
                ships.sort((a, b) => a.price - b.price);
                if (ships[0] && (salvage >= ships[0].price + arcade_depot_items().find(v => (v.kind === 'weapon') && (v.id === gun.id)).price)) {
                    buy('ship', ships[0].id);
                }
            }
            buy('weapon', options.gun);
        }
        while ((supplies.medkit < 2) && buy('supply', 'medkit')) {
            continue;
        }
        // the build the reactor holds; once it is bought, a sturdier ship (more power), a gun for each empty mount, and
        // the levels the next two worlds' power will hold
        if (buy_plan(build_plan())) {
            // the next sturdier ship the depot sells (one a later world opens waits for it) with no fewer mounts
            const on_sale = arcade_depot_items().filter(v => (v.kind === 'ship') && !v.done && (v.price !== null)).map(v => v.id);
            const sturdier = ship_catalog.filter(v => (v.hull > current_ship().hull) && (v.mounts.length >= current_ship().mounts.length) && on_sale.includes(v.id) && (!options.gun || gun_fits_ship(weapon_by_id(options.gun), v))).sort((a, b) => a.hull - b.hull)[0];
            if (sturdier) {
                buy('ship', sturdier.id);
            }
            // each empty mount gets one more of its gun, as the depot's Buy another offers
            while (buy('weapon', current_weapon().id)) {
                continue;
            }
            if (!sturdier || (current_ship().hull >= sturdier.hull)) {
                // Reactor tuning while the salvage lasts, each a level more of the build
                while (buy('reactor', 'tuning')) {
                    buy_plan(build_plan());
                }
                buy_plan(build_plan(2));
            }
        }
        install_plan(build_plan());
        while ((supplies.emp < 3) && buy('supply', 'emp')) {
            continue;
        }
        maxed_check();
        // what is left to buy after this depot: module levels (a launcher's only with the launcher) and ships
        const entry = world_entry();
        entry.levels_left = upgrade_options.filter(v => !module_needs_gun(v)).reduce((n, v) => n + v.cap - module_owned(v.key), 0);
        entry.power = [arcade_power_used(), arcade_power_capacity()];
        entry.ships_left = ship_catalog.filter(v => !ensure_career().ships.includes(v.id)).length;
        entry.salvage_after_depot = salvage;
        arcade_depot_close();
    }
    // The break: a card by --pick (none skips it), then the world by --route
    function pause_break() {
        if (arcade_break.step === 'pick') {
            const cards = arcade_break.cards;
            const wanted = (options.pick === 'random') ? Math.floor(Math.random()*cards.length) : cards.findIndex(v => arcade_card_def(v.id).kind === options.pick);
            const order = [wanted, ...cards.keys()].filter(v => (v >= 0) && arcade_card_affordable(cards[v]));
            if ((options.pick === 'none') || !order.length) {
                arcade_break.step = 'route';
                arcade_break.chosen = (arcade_break.offers.length === 1) ? 0 : -1;
                return;
            }
            arcade_break.chosen = order[0];
            B.cards.push(cards[order[0]].id);
            arcade_break_go();
            return;
        }
        const n = arcade_break.offers.length;
        arcade_break.chosen = (options.route === 'high') ? n - 1 : (options.route === 'random') ? Math.floor(Math.random()*n) : 0;
        arcade_break_go();
    }
    function step() {
        if (B.done) {
            return;
        }
        if (state === 'playing') {
            if (!B.snapshot || (B.snapshot.world !== campaign.world)) {
                B.snapshot = arcade_snapshot();
                // the kit the run brings into the world, after the depot: what a try-out of it starts with
                // (src/js/arcade_trial.js)
                world_entry().kit = {fleet: B.snapshot.fleet, owned: B.snapshot.owned, fitted: B.snapshot.fitted, reactor: B.snapshot.reactor, supplies: B.snapshot.supplies};
            }
            world_entry().time += 1/60;
            interest_sample();
            // waves 1 and 2 as they are flown: how many raiders are in play, and the seconds with under 3 (quiet)
            if ((arcade.wave >= 1) && (arcade.wave < arcade_wave_count()) && (arcade.pause <= 0)) {
                const n = enemies.filter(v => (v.hp > 0) && !v.anchor).length;
                world_entry().wave_time += 1/60;
                world_entry().crowd += n/60;
                if (n < 3) {
                    world_entry().quiet += 1/60;
                }
            }
            if (enemies.some(v => (v.type === 'boss') && (v.hp > 0))) {
                world_entry().flagship.time += 1/60;
            }
            if (arcade.flagship_escaped) {
                world_entry().flagship.escaped = true;
            }
            // a pulse fired: the charge was full a frame ago and is spent now (a drain, Eclipse's or the beam's, takes
            // a little)
            if ((B.energy_last >= 100) && (player.energy < 50)) {
                world_entry().pulses++;
            }
            B.energy_last = player.energy;
            fly();
        }
        else if ((state === 'finale') && (finale.world >= 0)) {
            finale_leave('depot');
        }
        // a Scroll world's cleared screen (src/js/arcade_lane_clear.js)
        else if (state === 'lane_clear') {
            lane_clear_leave();
        }
        else if (state === 'arcade_break') {
            pause_break();
        }
        else if (state === 'arcade_depot') {
            shop();
        }
        else if ((state === 'dead') || (state === 'won') || ((state === 'finale') && (finale.world < 0))) {
            // a death with lives left retries the world as the game's Retry does; the last one loses the run
            if (state === 'dead') {
                B.deaths++;
                world_entry().deaths++;
                if (arcade.lives > 0) {
                    set_hidden(el.result_overlay, true);
                    arcade_retry();
                    return;
                }
            }
            B.won = state !== 'dead';
            B.done = true;
            keys.clear();
        }
    }
    B.report = function () {
        return {mode: options.mode, kind: options.kind, idle: options.idle, seed: options.seed, gun: options.gun, pick: options.pick, route_how: options.route, cards: B.cards, route: (arcade.route || []).map(v => worlds[v].name), done: B.done, won: B.won, deaths: B.deaths, run_time, score, salvage_left: salvage, maxed: B.maxed, kit: {ship: current_ship().id, guns: mounted_weapons().map(v => (v ? v.id : 'empty')), upgrades: {...upgrades}, owned: {...arcade.owned}, power: [arcade_power_used(), arcade_power_capacity()]}, worlds: B.worlds};
    };
    const base_frame = frame;
    frame = function () {
        const request = window.requestAnimationFrame;
        window.requestAnimationFrame = function () {
            return 0;
        };
        const base_render = render;
        render = function () {};
        for (let i = 0; (i < 60) && !B.done; ++i) {
            window.__vt += 1000/60;
            step();
            base_frame(window.__vt);
        }
        render = base_render;
        window.requestAnimationFrame = request;
        if (!B.done) {
            window.requestAnimationFrame(frame);
        }
    };
    arcade_kind_pick(options.kind);
    arcade_start(0);
    window.requestAnimationFrame(frame);
}
